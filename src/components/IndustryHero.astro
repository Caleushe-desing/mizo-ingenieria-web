---
import type { ImageMetadata } from 'astro';
import PhotoSlot from './PhotoSlot.astro';

interface Props {
	title: string;
	lead: string;
	imageLabel: string;
	image: ImageMetadata;
	quoteHref: string;
	whatsappHref: string;
}

const { title, lead, imageLabel, image, quoteHref, whatsappHref } = Astro.props;
---

<section class="mizo-band mizo-band-white relative overflow-hidden border-b border-ink/10 pt-24 text-ink sm:pt-32">
	<div class="relative mx-auto grid max-w-6xl items-center gap-8 px-5 pb-12 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:pb-24">
		<div>
			<p class="mizo-kicker">Sonido</p>
			<h1 class="mt-3 text-[2.15rem] font-extrabold leading-[1.08] sm:text-5xl">{title}</h1>
			<p class="mt-4 max-w-xl text-lg leading-8 text-ink/80">{lead}</p>
			<div class="mt-8 flex w-full max-w-md flex-col gap-3">
				<a href={quoteHref} class="mizo-btn">Cotizar este sonido</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mizo-btn-wa">WhatsApp</a>
			</div>
		</div>
		<PhotoSlot label={imageLabel} image={image} eager />
	</div>
</section>
