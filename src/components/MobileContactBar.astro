---
import { telUrl, whatsappUrl } from '../lib/site';
---

<nav
	class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-charcoal/95 backdrop-blur-sm sm:hidden"
	style="padding-bottom: env(safe-area-inset-bottom, 0px)"
	aria-label="Contacto rápido"
>
	<div class="grid grid-cols-3 divide-x divide-white/10">
		<a href={telUrl()} class="flex min-h-14 flex-col items-center justify-center gap-0.5 py-2 text-accent">
			<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
			</svg>
			<span class="text-[0.65rem] font-bold uppercase tracking-wide">Llamar</span>
		</a>
		<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="flex min-h-14 flex-col items-center justify-center gap-0.5 py-2 text-[#25D366]">
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M.057 24l1.687-6.163A11.87 11.87 0 01.16 11.892C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24z" />
			</svg>
			<span class="text-[0.65rem] font-bold uppercase tracking-wide">WhatsApp</span>
		</a>
		<a href="/contacto" class="flex min-h-14 flex-col items-center justify-center gap-0.5 py-2 text-orange">
			<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
			</svg>
			<span class="text-[0.65rem] font-bold uppercase tracking-wide">Cotizar</span>
		</a>
	</div>
</nav>
