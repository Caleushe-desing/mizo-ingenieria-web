---
import Layout from '../layouts/Layout.astro';
import PhotoSlot from './PhotoSlot.astro';
import QuoteForm from './QuoteForm.astro';
import { landingExtras } from '../lib/landing-extras';
import { landingMedia } from '../lib/landing-media';
import { SOUND_LANDINGS, landingPath, landingWhatsapp, type Landing } from '../lib/landings';
import { absoluteUrl, graphSchema, organizationSchema, serviceSchema, webPageSchema } from '../lib/seo';

interface Props {
	landing: Landing;
}

const { landing } = Astro.props;
const media = landingMedia[landing.slug];
const path = landingPath(landing.slug);
const mensaje = `Hola, quiero cotizar ${landing.keyword}.`;
const others = SOUND_LANDINGS.filter((item) => item.slug !== landing.slug);

const extra = landingExtras[landing.slug];

if (!media || !extra) {
	throw new Error(`Sin contenido para ${landing.slug}`);
}

const jsonLd = graphSchema([
	organizationSchema(),
	webPageSchema({ name: landing.seoTitle, description: landing.seoDescription, url: absoluteUrl(path) }),
	serviceSchema({
		name: landing.title,
		description: landing.seoDescription,
		url: absoluteUrl(path),
	}),
	{
		'@type': 'FAQPage',
		mainEntity: extra.faqs.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
]);
---

<Layout title={landing.seoTitle} description={landing.seoDescription} jsonLd={jsonLd}>
	<section class="mizo-band mizo-band-white relative overflow-hidden border-b border-ink/10 pt-24 text-ink sm:pt-32">
		<div class="relative mx-auto grid max-w-6xl items-center gap-8 px-5 pb-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:pb-16">
			<div>
				<p class="mizo-kicker">Sonido</p>
				<h1 class="mt-3 text-[2.15rem] font-extrabold leading-[1.08] sm:text-5xl">{landing.title}</h1>
				<p class="mt-4 max-w-xl text-xl leading-8 text-ink/80">{landing.lead}</p>
				<div class="mt-8 flex w-full max-w-md flex-col gap-3">
					<a href={landingWhatsapp(landing)} target="_blank" rel="noopener noreferrer" class="mizo-btn-wa">Cotizar por WhatsApp</a>
					<a href="#cotizar" class="mizo-btn">Solicitar asesoría rápida</a>
				</div>
			</div>
			<PhotoSlot label={landing.galleryAlts[0]} image={media.hero} eager />
		</div>
	</section>

	<section class="mizo-band mizo-band-gray py-10 sm:py-16" aria-label="Proyectos">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-extrabold">Así se ve instalado</h2>
			<div class="mt-5 grid gap-3 sm:grid-cols-3">
				{media.gallery.map((image, index) => (
					<PhotoSlot label={landing.galleryAlts[index] ?? landing.galleryAlts[0]} image={image} />
				))}
			</div>
		</div>
	</section>

	<section class="mizo-band mizo-band-white py-10 sm:py-16">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-extrabold">Qué ganas</h2>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{landing.points.map((point) => (
					<li class="flex min-h-14 items-center gap-3 border border-ink/10 bg-surface px-4 py-4 text-lg font-semibold leading-7 text-ink">
						<span class="h-2.5 w-2.5 shrink-0 bg-orange"></span>
						<span>{point}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="mizo-band mizo-band-gray border-b border-ink/10 py-10 sm:py-16" data-featured hidden data-landing={landing.slug}>
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-extrabold">Equipos que instalamos</h2>
			<div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-5 sm:gap-4" data-featured-list></div>
		</div>
	</section>

	<section class="mizo-band mizo-band-soft py-10 sm:py-16">
		<div class="mx-auto grid max-w-6xl gap-8 px-5 sm:px-6 lg:grid-cols-2 lg:px-8">
			<div>
				<h2 class="text-2xl font-extrabold">Incluye</h2>
				<ul class="mt-4 space-y-3">
					{extra.included.map((item) => (
						<li class="flex gap-3 text-lg leading-7 text-ink">
							<span class="mt-2 h-2 w-2 shrink-0 bg-orange"></span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>
			<ol class="space-y-3">
				{extra.steps.map((step, index) => (
					<li class="border border-ink/10 bg-surface px-4 py-4">
						<p class="text-lg font-extrabold">{index + 1}. {step.title}</p>
						<p class="mt-1 text-base leading-6 text-ink/75">{step.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="mizo-band mizo-band-white py-10 sm:py-16">
		<div class="mx-auto max-w-3xl px-5 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-extrabold">Preguntas cortas</h2>
			<div class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
				{extra.faqs.map((item) => (
					<details class="py-4">
						<summary class="cursor-pointer text-lg font-extrabold text-ink">{item.q}</summary>
						<p class="mt-2 text-base leading-7 text-ink/75">{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section id="cotizar" class="mizo-band mizo-band-soft scroll-mt-24 py-10 sm:py-16">
		<div class="mx-auto grid max-w-6xl gap-8 px-5 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
			<div>
				<h2 class="text-2xl font-extrabold leading-tight">Solicitar asesoría rápida</h2>
				<p class="mt-3 text-lg leading-7 text-ink/75">Cuéntanos el lugar. Te respondemos hoy.</p>
				<a href={landingWhatsapp(landing)} target="_blank" rel="noopener noreferrer" class="mizo-btn-wa mt-6">Cotizar por WhatsApp</a>
			</div>
			<div class="border border-ink/10 bg-surface shadow-card">
				<QuoteForm servicio={landing.title} mensaje={mensaje} />
			</div>
		</div>
	</section>

	<section class="border-t border-ink/10 py-10">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<h2 class="text-lg font-extrabold">También instalamos</h2>
			<ul class="mt-4 grid gap-3 sm:grid-cols-2">
				{others.map((item) => (
					<li>
						<a href={landingPath(item.slug)} class="block min-h-14 border border-ink/10 bg-surface px-4 py-4 text-lg font-extrabold hover:border-accent">
							{item.nav}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Layout>

<script is:inline define:vars={{ slug: landing.slug, title: landing.title }}>
	(function () {
		var root = document.querySelector('[data-featured][data-landing="' + slug + '"]');
		var list = root && root.querySelector('[data-featured-list]');
		if (!root || !list) return;

		function text(tag, className, value) {
			var el = document.createElement(tag);
			el.className = className;
			el.textContent = value;
			return el;
		}

		function photoSrc(src) {
			if (typeof src !== 'string' || src === '') return '';
			if (src.charAt(0) === '/') return src;
			if (src.indexOf('crm/') === 0) return '/' + src;
			if (src.indexOf('uploads/productos/') === 0) return '/crm/' + src;
			return src;
		}

		fetch('/crm/api/productos-visibles.php?landing=' + encodeURIComponent(slug), { headers: { Accept: 'application/json' } })
			.then(function (res) { return res.json(); })
			.then(function (data) {
				var items = data && Array.isArray(data.productos) ? data.productos : [];
				if (!items.length) return;
				items.forEach(function (item) {
					var card = document.createElement('article');
					card.className = 'flex h-full flex-col border border-ink/10 bg-surface';
					var photos = Array.isArray(item.imagenes) ? item.imagenes.map(photoSrc).filter(Boolean) : [];
					if (photos.length) {
						var img = document.createElement('img');
						img.src = photos[0];
						img.alt = item.nombre || item.sku || 'Producto';
						img.className = 'aspect-[4/3] w-full object-cover';
						img.loading = 'lazy';
						card.appendChild(img);
					}
					var body = document.createElement('div');
					body.className = 'flex flex-1 flex-col p-5';
					body.appendChild(text('h3', 'text-base font-extrabold leading-snug', item.nombre || item.sku || 'Producto'));
					var link = document.createElement('a');
					var message = 'Quiero cotizar el producto ' + (item.nombre || '') + ' (SKU ' + (item.sku || '') + ') para ' + title + '.';
					link.href = '/contacto?sku=' + encodeURIComponent(item.sku || '') + '&mensaje=' + encodeURIComponent(message) + '&servicio=' + encodeURIComponent(title);
					link.className = 'mt-4 text-sm font-bold text-accent-dark';
					link.textContent = 'Cotizar este equipo';
					body.appendChild(link);
					card.appendChild(body);
					list.appendChild(card);
				});
				root.hidden = false;
			})
			.catch(function () {});
	})();
</script>
