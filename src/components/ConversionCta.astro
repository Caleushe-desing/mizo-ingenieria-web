---
import { whatsappUrl } from '../lib/site';

interface Props {
	title?: string;
	text?: string;
	quoteHref?: string;
	whatsappHref?: string;
}

const {
	title = '¿Tienes un recinto que equipar?',
	text = 'Cuéntanos el espacio y te respondemos con una propuesta clara.',
	quoteHref = '/contacto',
	whatsappHref = whatsappUrl(),
} = Astro.props;
---

<section class="border-t border-white/10 bg-charcoal py-16" aria-label="Cotizar">
	<div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
		<div>
			<h2 class="text-2xl font-extrabold sm:text-3xl">{title}</h2>
			<p class="mt-2 max-w-xl text-white/65">{text}</p>
		</div>
		<div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
			<a href={quoteHref} class="mizo-btn">Solicitar cotización</a>
			<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mizo-btn-ghost">WhatsApp</a>
		</div>
	</div>
</section>
