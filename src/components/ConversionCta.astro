---
import { Image } from 'astro:assets';
import { SUPPORT_PROMISES } from '../lib/industries';
import { whatsappUrl } from '../lib/site';
import soporteLocal from '../assets/soporte/soporte-local.jpg';
import postventa from '../assets/soporte/postventa.jpg';
import respuestaRapida from '../assets/soporte/respuesta-rapida.jpg';
import pagoTarjeta from '../assets/soporte/pago-tarjeta.jpg';

interface Props {
	title?: string;
	text?: string;
	quoteHref?: string;
	whatsappHref?: string;
}

const {
	title = '¿Tienes un recinto que equipar?',
	text = 'Cuéntanos el espacio y te respondemos con una propuesta clara.',
	quoteHref = '/contacto',
	whatsappHref = whatsappUrl(),
} = Astro.props;

const supportPhotos = {
	'Soporte técnico local': soporteLocal,
	'Postventa garantizada': postventa,
	'Respuesta rápida': respuestaRapida,
	'Pago con tarjeta': pagoTarjeta,
} as const;
---

<section class="border-t border-white/10 bg-charcoal py-20 sm:py-28" aria-label="Cotizar">
	<div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
		<div>
			<h2 class="text-2xl font-extrabold leading-tight text-white sm:text-3xl">{title}</h2>
			<p class="mt-3 max-w-xl text-base leading-7 text-white/80">{text}</p>
		</div>
		<div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
			<a href={quoteHref} class="mizo-btn">Solicitar cotización</a>
			<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mizo-btn-ghost">WhatsApp</a>
		</div>
	</div>
	<ul class="mx-auto mt-16 grid max-w-6xl gap-3 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
		{SUPPORT_PROMISES.map((item) => (
			<li class="mizo-card border border-white/10 bg-charcoal">
				<Image
					src={supportPhotos[item.title]}
					alt={item.title}
					class="aspect-[4/3] w-full object-cover"
					widths={[480, 800, 1200]}
					sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
					format="webp"
					quality={74}
					loading="lazy"
				/>
				<div class="px-5 py-5">
					<p class="text-sm font-extrabold text-white">{item.title}</p>
					<p class="mt-2 text-sm leading-6 text-white/75">{item.detail}</p>
				</div>
			</li>
		))}
	</ul>
</section>
