---
import { INDUSTRIES, industryPath } from '../lib/industries';
import { LANDINGS, landingPath } from '../lib/landings';
import { mailUrl, NAV, SITE, telUrl, whatsappUrl } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-ink/10 bg-surface text-ink/75">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="md:col-span-1">
				<a href="/" class="inline-block" aria-label="Mizo — Inicio">
					<img src={SITE.logo} alt="Mizo" class="h-12 w-auto" width="210" height="56" />
				</a>
				<p class="mt-4 max-w-xs text-sm leading-6 text-ink/70">
					Ingeniería e instalación de sonido, video, seguridad y soporte TI en Chile.
				</p>
			</div>

			<div>
				<h2 class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">Sitio</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{NAV.map((item) => (
						<li><a href={item.href} class="transition-all duration-300 hover:text-accent-dark">{item.title}</a></li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">Soluciones</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{INDUSTRIES.map((industry) => (
						<li><a href={industryPath(industry.slug)} class="transition-all duration-300 hover:text-accent-dark">{industry.nav}</a></li>
					))}
					<li><a href="/equipos" class="transition-all duration-300 hover:text-accent-dark">Productos</a></li>
				</ul>
				<h2 class="mt-8 text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">Instalaciones</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{LANDINGS.map((landing) => (
						<li><a href={landingPath(landing.slug)} class="transition-all duration-300 hover:text-accent-dark">{landing.nav}</a></li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">Contacto</h2>
				<ul class="mt-4 space-y-2 text-sm">
					<li><a href={mailUrl()} class="transition-all duration-300 hover:text-accent-dark">{SITE.email}</a></li>
					<li><a href={telUrl()} class="transition-all duration-300 hover:text-accent-dark">{SITE.phoneDisplay}</a></li>
					<li><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="transition-all duration-300 hover:text-accent-dark">WhatsApp</a></li>
					<li>{SITE.address}</li>
					<li>{SITE.hours}</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col gap-3 border-t border-ink/10 pt-8 text-sm text-ink/60 sm:flex-row sm:items-center sm:justify-between">
			<p>© {year} Mizo. Todos los derechos reservados.</p>
			<div class="flex gap-4">
				<a href="/politica-privacidad" class="hover:text-accent-dark">Política de privacidad</a>
				<a href="/terminos" class="hover:text-accent-dark">Términos</a>
			</div>
		</div>
	</div>
</footer>
