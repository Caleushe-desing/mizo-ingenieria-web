---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	label: string;
	image: ImageMetadata;
	eager?: boolean;
	class?: string;
}

const { label, image, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['relative aspect-[16/10] overflow-hidden bg-charcoal-muted', className]}>
	<Image
		src={image}
		alt={label}
		class="h-full w-full object-cover"
		widths={[480, 800, 1200]}
		sizes="(min-width: 1024px) 50vw, 100vw"
		format="webp"
		quality={72}
		loading={eager ? 'eager' : 'lazy'}
	/>
</figure>
