---
interface Props {
	label: string;
	class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<figure class:list={['relative aspect-[16/10] overflow-hidden bg-charcoal-muted', className]}>
	<div class="mizo-grid pointer-events-none absolute inset-0 opacity-25"></div>
	<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/25 to-accent/20"></div>
	<div class="absolute left-4 top-4 border border-white/25 bg-charcoal/50 px-2.5 py-1 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-white/80">
		Fotografía
	</div>
	<figcaption class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
		<p class="text-sm font-semibold leading-5 text-white">{label}</p>
		<p class="mt-1 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-white/45">Espacio reservado</p>
	</figcaption>
</figure>
