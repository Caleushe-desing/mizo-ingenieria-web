---
import { Image } from 'astro:assets';
import { techMedia } from '../lib/tech-images';
import { TECH_STANDARDS } from '../lib/tech-standards';

interface Props {
	variant?: 'full' | 'teaser';
}

const { variant = 'full' } = Astro.props;
---

{variant === 'teaser' ? (
	<section class="border-t border-white/10 bg-charcoal py-20 sm:py-28" aria-labelledby="estandares-teaser-heading">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Estándares</p>
			<h2 id="estandares-teaser-heading" class="mt-3 max-w-2xl text-3xl font-extrabold sm:text-4xl">Hardware de grado profesional, elegido para el recinto.</h2>
			<p class="mt-4 max-w-2xl text-sm leading-7 text-white/80">
				Cuatro familias de equipo con las que se diseña. El criterio es el desempeño del espacio, no un listado de precios.
			</p>
			<ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{TECH_STANDARDS.map((item) => (
					<li class="mizo-card border border-white/10 bg-charcoal hover:border-accent/50">
						<a href={`/estandares#${item.id}`} class="block px-6 py-7">
							<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{item.kicker}</p>
							<h3 class="mt-3 text-lg font-extrabold leading-snug">{item.title}</h3>
							<p class="mt-3 text-sm leading-6 text-white/75">{item.lead}</p>
						</a>
					</li>
				))}
			</ul>
			<a href="/estandares" class="mt-8 inline-block text-sm font-bold uppercase tracking-[0.12em] text-orange">Ver estándares</a>
		</div>
	</section>
) : (
	<section class="bg-charcoal py-20 sm:py-28" aria-label="Familias de hardware">
		<div class="mx-auto grid max-w-6xl gap-20 px-4 sm:px-6 lg:gap-28 lg:px-8">
			{TECH_STANDARDS.map((item, index) => (
				<article id={item.id} class="scroll-mt-28 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
					<figure class:list={['overflow-hidden border border-white/10', index % 2 === 1 && 'lg:order-2']}>
						<Image
							src={techMedia[item.id]}
							alt={item.title}
							class="aspect-[16/10] h-full w-full object-cover"
							widths={[640, 960, 1280]}
							sizes="(min-width: 1024px) 50vw, 100vw"
							format="webp"
							quality={74}
							loading={index === 0 ? 'eager' : 'lazy'}
						/>
					</figure>
					<div>
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{item.kicker}</p>
						<h2 class="mt-3 text-3xl font-extrabold leading-tight">{item.title}</h2>
						<p class="mt-4 text-lg leading-8 text-white/80">{item.lead}</p>
						<p class="mt-4 text-sm leading-7 text-white/75">{item.detail}</p>
					</div>
				</article>
			))}
		</div>
	</section>
)}
