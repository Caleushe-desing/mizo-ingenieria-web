---
import type { ImageMetadata } from 'astro';
import PhotoSlot from './PhotoSlot.astro';
import type { IndustrySolution } from '../lib/industries';

interface Props {
	solutions: readonly IndustrySolution[];
	images: Record<string, ImageMetadata>;
}

const { solutions, images } = Astro.props;
const columns = solutions.length === 4 ? 'lg:grid-cols-2' : 'lg:grid-cols-3';
---

<nav class="border-b border-white/10 bg-charcoal-light/40" aria-label="Soluciones de esta industria">
	<div class="mx-auto flex max-w-6xl gap-px overflow-x-auto bg-white/10 px-4 sm:px-6 lg:px-8">
		{solutions.map((solution, index) => (
			<a href={`#${solution.id}`} class="mizo-card shrink-0 bg-charcoal px-4 py-4 text-sm font-semibold text-white/80 hover:text-white">
				<span class="mr-2 text-[0.65rem] text-orange">{String(index + 1).padStart(2, '0')}</span>
				{solution.title}
			</a>
		))}
	</div>
</nav>

<section class="bg-charcoal py-20 sm:py-28" aria-labelledby="soluciones-heading">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<p class="mizo-kicker">Soluciones</p>
		<h2 id="soluciones-heading" class="mt-3 max-w-2xl text-3xl font-extrabold sm:text-4xl">Qué instalamos en este tipo de recinto.</h2>
		<div class:list={['mt-12 grid gap-4', columns]}>
			{solutions.map((solution) => (
				<article id={solution.id} class="mizo-card scroll-mt-36 flex flex-col border border-white/10 bg-charcoal">
					<PhotoSlot label={solution.imageLabel} image={images[solution.id]} />
					<div class="flex flex-1 flex-col p-6 sm:p-7">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-accent">{solution.eyebrow}</p>
						<h3 class="mt-2 text-xl font-extrabold leading-snug">{solution.title}</h3>
						<p class="mt-3 text-sm leading-7 text-white/80">{solution.description}</p>
						<ul class="mt-5 space-y-2 border-t border-white/10 pt-5 text-sm text-white/85">
							{solution.points.map((point) => (
								<li class="flex gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 bg-orange"></span>
									<span>{point}</span>
								</li>
							))}
						</ul>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
