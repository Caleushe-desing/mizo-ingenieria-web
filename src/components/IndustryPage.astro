---
import ConversionCta from './ConversionCta.astro';
import IndustryAssurance from './IndustryAssurance.astro';
import IndustryHero from './IndustryHero.astro';
import IndustrySolutions from './IndustrySolutions.astro';
import Layout from '../layouts/Layout.astro';
import { industryPath, industryQuoteUrl, industryWhatsapp, type Industry } from '../lib/industries';
import { industryMedia } from '../lib/industry-images';
import { absoluteUrl, graphSchema, organizationSchema, serviceSchema, webPageSchema } from '../lib/seo';

interface Props {
	industry: Industry;
}

const { industry } = Astro.props;
const media = industryMedia[industry.slug];
const path = industryPath(industry.slug);
const title = `${industry.title} | Mizo`;
const description = industry.short;

const jsonLd = graphSchema([
	organizationSchema(),
	webPageSchema({ name: title, description, url: absoluteUrl(path) }),
	...industry.solutions.map((solution) =>
		serviceSchema({
			name: `${solution.title} — ${industry.title}`,
			description: solution.description,
			url: absoluteUrl(`${path}#${solution.id}`),
		}),
	),
]);
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<IndustryHero title={industry.title} lead={industry.lead} imageLabel={industry.imageLabel} image={media.hero} />
	<IndustryAssurance block="standards" />
	<IndustrySolutions solutions={industry.solutions} images={media.solutions} />
	<IndustryAssurance block="method" />
	<ConversionCta
		title="¿Este es el recinto que quieres equipar?"
		text={`Cuéntanos el espacio y armamos una propuesta de instalación para ${industry.title.toLowerCase()}.`}
		quoteHref={industryQuoteUrl(industry)}
		whatsappHref={industryWhatsapp(industry)}
	/>
</Layout>
