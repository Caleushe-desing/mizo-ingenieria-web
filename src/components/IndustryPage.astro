---
import ServiceLanding from './ServiceLanding.astro';
import { industryPageBySlug } from '../lib/industry-pages';
import { industryPath, industryWhatsapp, type Industry } from '../lib/industries';
import type { Landing } from '../lib/landings';

interface Props {
	industry: Industry;
}

const { industry } = Astro.props;
const page = industryPageBySlug(industry.slug);

if (!page) {
	throw new Error(`Sin página para ${industry.slug}`);
}

const landing: Landing = {
	slug: page.slug,
	nav: page.nav,
	keyword: page.keyword,
	title: page.title,
	seoTitle: page.seoTitle,
	seoDescription: page.seoDescription,
	lead: page.lead,
	consult: page.consult,
	detail: page.lead,
	points: page.points,
	galleryAlts: [page.title, page.title, page.title] as const,
};
---

<ServiceLanding
	landing={landing}
	path={industryPath(page.slug)}
	whatsappHref={industryWhatsapp(industry)}
	extra={{ included: page.included, steps: page.steps, faqs: page.faqs }}
/>
