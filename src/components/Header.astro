---
import { INDUSTRIES, industryPath } from '../lib/industries';
import { NAV, SITE, telUrl, whatsappUrl } from '../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
	if (href === '/') return currentPath === '/';
	if (href === '/industrias' && currentPath === '/equipos') return true;
	return currentPath === href || currentPath.startsWith(`${href}/`);
};

const linkClass = (active: boolean) =>
	`px-3 py-2 text-sm font-semibold transition-all duration-300 ${
		active ? 'text-accent-dark' : 'text-ink/75 hover:text-ink'
	}`;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-ink/10 bg-surface/95 backdrop-blur-sm">
	<div class="relative mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:h-[4.5rem] sm:px-6 lg:px-8">
		<a href="/" class="flex shrink-0 items-center" aria-label="Mizo — Inicio">
			<img src={SITE.logo} alt="Mizo" class="h-9 w-auto sm:h-11" width="180" height="48" />
		</a>

		<nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Principal">
			{NAV.map((item) =>
				item.href === '/industrias' ? (
					<div class="group relative">
						<a href={item.href} class={linkClass(isActive(item.href))} aria-current={isActive(item.href) ? 'page' : undefined}>
							{item.title}
						</a>
						<div class="invisible absolute left-0 top-full z-50 w-72 border border-ink/10 bg-surface py-2 opacity-0 shadow-card transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
							{INDUSTRIES.map((industry) => (
								<a
									href={industryPath(industry.slug)}
									class="block px-4 py-2.5 text-sm font-semibold text-ink/80 transition-all duration-300 hover:bg-accent-soft hover:text-ink"
								>
									{industry.nav}
								</a>
							))}
							<a
								href="/equipos"
								class="block border-t border-ink/10 px-4 py-2.5 text-sm font-semibold text-ink/80 transition-all duration-300 hover:bg-accent-soft hover:text-ink"
							>
								Productos
							</a>
						</div>
					</div>
				) : (
					<a href={item.href} class={linkClass(isActive(item.href))} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.title}
					</a>
				),
			)}
		</nav>

		<div class="ml-auto hidden items-center gap-2 lg:ml-4 lg:flex">
			<a
				href={whatsappUrl()}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-10 items-center bg-[#25D366] px-4 text-sm font-semibold uppercase tracking-[0.12em] text-white transition-all duration-300 hover:bg-[#1ebe5d] hover:shadow-glow"
			>
				WhatsApp
			</a>
			<a href="/contacto" class="inline-flex h-10 items-center bg-orange px-5 text-sm font-semibold uppercase tracking-[0.12em] text-white transition-all duration-300 hover:bg-orange-hover hover:shadow-glow-orange">
				Cotizar
			</a>
		</div>

		<details class="group relative ml-auto lg:hidden">
			<summary class="nav-summary flex h-10 w-10 cursor-pointer items-center justify-center border border-ink/20 text-ink" aria-label="Abrir menú">
				<svg class="h-5 w-5 group-open:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
				</svg>
				<svg class="hidden h-5 w-5 group-open:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</summary>
			<nav class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-[min(calc(100vw-2rem),20rem)] border border-ink/10 bg-surface p-3 shadow-card" aria-label="Móvil">
				<div class="flex flex-col gap-1">
					{NAV.map((item) => (
						<div>
							<a
								href={item.href}
								class={`block px-3 py-3 text-base font-semibold ${isActive(item.href) ? 'bg-accent-soft text-accent-dark' : 'text-ink/80 hover:bg-paper hover:text-ink'}`}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.title}
							</a>
							{item.href === '/industrias' && (
								<div class="mb-1 ml-3 border-l border-ink/10">
									{INDUSTRIES.map((industry) => (
										<a href={industryPath(industry.slug)} class="block px-3 py-2 text-sm text-ink/70 hover:text-ink">
											{industry.nav}
										</a>
									))}
									<a href="/equipos" class="block px-3 py-2 text-sm text-ink/70 hover:text-ink">Productos</a>
								</div>
							)}
						</div>
					))}
					<div class="mt-3 grid grid-cols-2 gap-2">
						<a href={telUrl()} class="border border-ink/20 px-3 py-3 text-center text-sm font-semibold text-ink">Llamar</a>
						<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] px-3 py-3 text-center text-sm font-semibold text-white">WhatsApp</a>
					</div>
					<a href="/contacto" class="mt-2 bg-orange px-3 py-3 text-center text-sm font-semibold uppercase tracking-[0.12em] text-white">Cotizar</a>
				</div>
			</nav>
		</details>
	</div>
</header>
