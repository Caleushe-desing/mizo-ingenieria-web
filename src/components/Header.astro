---
const currentPath = Astro.url.pathname;

const navLinks = [
	{ title: 'Inicio', url: '/' },
	{ title: 'Servicios', url: '/servicios' },
	{ title: 'Productos', url: '/productos' },
	{ title: 'Proyectos', url: '/#proyectos' },
	{ title: 'Nosotros', url: '/nosotros' },
	{ title: 'Contacto', url: '/contacto' },
];

const isActive = (url: string) => {
	const base = url.split('?')[0].split('#')[0];
	if (base === '/') return currentPath === '/';
	return currentPath === base || currentPath.startsWith(`${base}/`);
};

const waLink = 'https://wa.me/56994390870?text=Hola%20Mizo,%20quiero%20cotizar%20un%20proyecto%20de%20audio%20o%20videoproyecci%C3%B3n';
const logoSrc = '/mizo-logo.png';
const logoAlt = 'Mizo Ingeniería - Instalación de sonido y videoproyección en Chile';
---

<header class="sticky top-0 z-50">
	<div class="h-1.5 bg-gradient-to-r from-brand-orange via-accent-main to-brand-orange" aria-hidden="true"></div>

	<div class="border-b border-white/10 bg-ink/95 text-white shadow-lg shadow-black/20 backdrop-blur-md">
		<div class="mx-auto flex h-[4.25rem] max-w-7xl items-center gap-3 px-4 sm:gap-5 sm:px-6 lg:px-8">
			<a href="/" class="group flex min-w-0 shrink-0 items-center gap-3">
				<img
					src={logoSrc}
					alt={logoAlt}
					class="h-10 w-auto object-contain transition group-hover:brightness-110 sm:h-11"
					width="180"
					height="60"
					onerror="this.onerror=null; this.src='/mizo-logo.svg';"
				/>
				<div class="hidden min-w-0 border-l border-white/15 pl-3 sm:block">
					<p class="truncate text-[0.68rem] font-black uppercase tracking-[0.2em] text-brand-orange">Mizo Ingeniería</p>
					<p class="truncate text-xs font-semibold text-white/75">Sonido · Video · Electricidad · Chile</p>
				</div>
			</a>

			<nav class="hidden flex-1 items-center justify-center gap-0.5 lg:flex" aria-label="Navegación principal">
				{navLinks.map((link) => (
					<a
						href={link.url}
						class:list={[
							'relative rounded-lg px-3 py-2 text-sm font-semibold transition duration-200',
							isActive(link.url)
								? 'bg-white/10 text-white'
								: 'text-white/80 hover:bg-white/5 hover:text-white',
						]}
						aria-current={isActive(link.url) ? 'page' : undefined}
					>
						{link.title}
						{isActive(link.url) && (
							<span class="absolute inset-x-3 -bottom-0.5 h-0.5 rounded-full bg-brand-orange" aria-hidden="true"></span>
						)}
					</a>
				))}
			</nav>

			<div class="ml-auto flex items-center gap-2">
				<a
					href="tel:+56994390870"
					class="hidden items-center gap-1.5 rounded-full border border-white/15 px-3 py-2 text-xs font-bold text-white/90 transition hover:border-accent-main hover:text-white xl:inline-flex"
				>
					<span aria-hidden="true">☎</span>
					+56 9 9439 0870
				</a>

				<a
					href={waLink}
					target="_blank"
					rel="noopener noreferrer"
					class="hidden items-center justify-center rounded-full border border-green-500/40 bg-green-600/90 p-2.5 text-white transition hover:bg-green-500 sm:inline-flex"
					aria-label="WhatsApp Mizo"
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.929-1.03z" />
					</svg>
				</a>

				<a
					href="/contacto"
					class="hidden rounded-full bg-brand-orange px-4 py-2.5 text-sm font-black text-white shadow-lg shadow-brand-orange/25 transition hover:bg-brand-orange-hover sm:inline-flex"
				>
					Cotizar proyecto
				</a>

				<button
					id="mobile-menu-button"
					type="button"
					class="inline-flex items-center justify-center rounded-lg border border-white/15 p-2.5 text-white transition hover:bg-white/10 lg:hidden"
					aria-controls="mobile-menu"
					aria-expanded="false"
				>
					<span class="sr-only">Abrir menú</span>
					<svg id="icon-menu" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
					<svg id="icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>
	</div>

	<div class="hidden border-b border-white/10 bg-charcoal lg:hidden" id="mobile-menu">
		<div class="mx-auto max-w-7xl space-y-1 px-4 py-3 sm:px-6 lg:px-8">
			{navLinks.map((link) => (
				<a
					href={link.url}
					class:list={[
						'block rounded-lg px-3 py-2.5 text-sm font-semibold transition',
						isActive(link.url) ? 'bg-white/10 text-white' : 'text-white/85 hover:bg-white/5 hover:text-white',
					]}
					aria-current={isActive(link.url) ? 'page' : undefined}
				>
					{link.title}
				</a>
			))}
			<div class="grid gap-2 border-t border-white/10 pt-3 sm:grid-cols-2">
				<a href="tel:+56994390870" class="rounded-lg bg-white/5 px-4 py-2.5 text-center text-sm font-bold text-white">+56 9 9439 0870</a>
				<a
					href={waLink}
					target="_blank"
					rel="noopener noreferrer"
					class="rounded-lg bg-green-600 px-4 py-2.5 text-center text-sm font-bold text-white"
				>
					WhatsApp
				</a>
				<a href="/contacto" class="rounded-lg bg-brand-orange px-4 py-2.5 text-center text-sm font-black text-white sm:col-span-2">
					Solicitar cotización
				</a>
			</div>
		</div>
	</div>
</header>

<script is:inline>
	function initMobileMenu() {
		const button = document.getElementById('mobile-menu-button');
		const menu = document.getElementById('mobile-menu');
		const iconMenu = document.getElementById('icon-menu');
		const iconClose = document.getElementById('icon-close');
		if (!button || !menu || !iconMenu || !iconClose) return;

		menu.classList.add('hidden');

		const toggleMenu = () => {
			const isOpen = menu.classList.toggle('hidden') === false;
			iconMenu.classList.toggle('hidden', isOpen);
			iconClose.classList.toggle('hidden', !isOpen);
			document.body.classList.toggle('overflow-hidden', isOpen);
			button.setAttribute('aria-expanded', String(isOpen));
		};

		button.onclick = toggleMenu;
		menu.onclick = (event) => {
			if (event.target.tagName === 'A' && !menu.classList.contains('hidden')) toggleMenu();
		};
	}

	document.addEventListener('DOMContentLoaded', initMobileMenu);
	document.addEventListener('astro:page-load', initMobileMenu);
</script>
