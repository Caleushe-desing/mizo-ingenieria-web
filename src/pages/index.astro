---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ConversionCta from '../components/ConversionCta.astro';
import heroImage from '../assets/hero-instalacion.jpg';
import { INDUSTRIES } from '../lib/industries';
import { industryMedia } from '../lib/industry-images';
import { BRANDS, SITE } from '../lib/site';
import { absoluteUrl, graphSchema, localBusinessSchema, organizationSchema, webPageSchema, websiteSchema } from '../lib/seo';

const jsonLd = graphSchema([
	organizationSchema(),
	localBusinessSchema(),
	websiteSchema(),
	webPageSchema({
		name: SITE.title,
		description: SITE.description,
		url: absoluteUrl('/'),
	}),
]);

const [featured, ...rest] = INDUSTRIES;
---

<Layout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
	<section class="relative isolate min-h-[70vh] overflow-hidden bg-charcoal pt-36 text-white sm:pt-44 lg:min-h-0 lg:pt-48">
		<Image
			src={heroImage}
			alt="Instalación profesional de audio y video en un recinto"
			class="absolute inset-0 h-full w-full object-cover"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			format="webp"
			quality={78}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/75 to-charcoal/20"></div>
		<div class="relative mx-auto flex min-h-[52vh] max-w-6xl flex-col justify-end px-4 pb-20 sm:px-6 sm:pb-24 lg:min-h-[32rem] lg:px-8 lg:pb-20">
			<p class="mizo-kicker">Mizo</p>
			<h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-6xl lg:text-5xl">El recinto define la instalación.</h1>
			<p class="mt-5 max-w-xl text-lg leading-8 text-white/85">
				Audio, imagen y control en {SITE.areas.join(', ')}. Elige el rubro y abre su página.
			</p>
			<a href="/industrias" class="mizo-btn mt-8 w-fit">Ver soluciones</a>
		</div>
	</section>

	<section class="bg-charcoal pt-24 sm:pt-32 lg:mx-auto lg:max-w-6xl lg:pt-36" aria-label="Rubros">
		<div class="relative block min-h-[28rem] overflow-hidden lg:min-h-[20rem]">
			<Image
				src={industryMedia[featured.slug].hero}
				alt={featured.imageLabel}
				class="absolute inset-0 h-full w-full object-cover"
				widths={[800, 1200, 1920]}
				sizes="100vw"
				format="webp"
				quality={74}
				loading="eager"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/20 to-transparent"></div>
			<div class="relative flex min-h-[28rem] items-end px-4 py-10 sm:px-8 lg:min-h-[20rem] lg:py-8">
				<div>
					<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">{featured.nav}</p>
					<h2 class="mt-2 text-3xl font-extrabold sm:text-5xl lg:text-4xl">{featured.title}</h2>
				</div>
			</div>
		</div>
		<div class="grid sm:grid-cols-2 lg:grid-cols-4">
			{rest.map((industry) => (
				<div class="relative block min-h-72 overflow-hidden lg:min-h-52">
					<Image
						src={industryMedia[industry.slug].hero}
						alt={industry.imageLabel}
						class="absolute inset-0 h-full w-full object-cover"
						widths={[640, 960, 1280]}
						sizes="(min-width: 640px) 50vw, 100vw"
						format="webp"
						quality={72}
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/15 to-transparent"></div>
					<div class="relative flex min-h-72 items-end p-6 lg:min-h-52 lg:p-5">
						<div>
							<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{industry.nav}</p>
							<h2 class="mt-1 text-2xl font-extrabold lg:text-lg">{industry.title}</h2>
						</div>
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="border-t border-white/10 bg-charcoal py-16 sm:py-24" aria-label="Marcas">
		<ul class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-white/10 sm:grid-cols-4 lg:grid-cols-7">
			{BRANDS.map((brand) => (
				<li class="flex h-20 items-center justify-center bg-charcoal px-4">
					<img
						src={`/images/marcas/${brand.slug}.svg`}
						alt={brand.name}
						class="max-h-8 max-w-[110px] object-contain brightness-0 invert opacity-80"
						width="110"
						height="32"
						loading="lazy"
					/>
				</li>
			))}
		</ul>
	</section>

	<ConversionCta />
</Layout>
