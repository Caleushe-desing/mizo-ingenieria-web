---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ConversionCta from '../components/ConversionCta.astro';
import heroImage from '../assets/hero-instalacion.jpg';
import { INDUSTRIES, industryPath } from '../lib/industries';
import { industryMedia } from '../lib/industry-images';
import { SOUND_LANDINGS, landingPath } from '../lib/landings';
import { content } from '../lib/content';
import { BRANDS, CLIENTS, SITE, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, localBusinessSchema, organizationSchema, webPageSchema, websiteSchema } from '../lib/seo';

const home = content.pages.home;

const jsonLd = graphSchema([
	organizationSchema(),
	localBusinessSchema(),
	websiteSchema(),
	webPageSchema({
		name: SITE.title,
		description: SITE.description,
		url: absoluteUrl('/'),
	}),
]);

---

<Layout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
	<section class="relative isolate flex min-h-[70svh] items-end overflow-hidden bg-charcoal pt-24 text-white sm:min-h-[85vh] sm:pt-36">
		<Image
			src={heroImage}
			alt={home.heroImageAlt}
			class="absolute inset-0 h-full w-full object-cover"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			format="webp"
			quality={78}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/80 to-charcoal/35"></div>
		<div class="relative mx-auto w-full max-w-6xl px-5 pb-10 sm:px-6 sm:pb-20 lg:px-8 lg:pb-24">
			<p class="mizo-kicker">{home.kicker}</p>
			<h1 class="mt-4 max-w-3xl text-[2.15rem] font-extrabold leading-[1.08] sm:text-6xl lg:text-5xl">{home.title}</h1>
			<p class="mt-4 max-w-xl text-lg leading-8 text-white/90">
				{home.lead}
			</p>
			<div class="mt-8 flex w-full max-w-md flex-col gap-3">
				<a href="/contacto" class="mizo-btn">{home.ctaLabel}</a>
				<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="mizo-btn-wa">WhatsApp</a>
			</div>
		</div>
	</section>

	<section class="mizo-band mizo-band-white py-12 sm:py-20" aria-labelledby="sonido-heading">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Servicios</p>
			<h2 id="sonido-heading" class="mt-3 max-w-2xl text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
				Instalación de audio, lista para cotizar
			</h2>
			<div class="mt-8 grid gap-4">
				{SOUND_LANDINGS.map((landing) => (
					<a href={landingPath(landing.slug)} class="mizo-card flex overflow-hidden border border-ink/10 bg-surface hover:border-accent">
						<span class="w-1.5 shrink-0 bg-orange"></span>
						<span class="block px-5 py-5">
							<h3 class="text-2xl font-extrabold leading-tight text-ink">{landing.title}</h3>
							<p class="mt-2 text-base leading-7 text-ink/75">{landing.lead}</p>
							<span class="mt-4 inline-block text-base font-bold text-accent-dark">Cotizar {landing.nav}</span>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="mizo-band mizo-band-gray py-12 sm:py-28" aria-labelledby="rubros-heading">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<p class="mizo-kicker">{home.rubrosKicker}</p>
			<h2 id="rubros-heading" class="mt-3 max-w-2xl text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
				{home.rubrosTitle}
			</h2>
			<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-8">
				{INDUSTRIES.map((industry) => (
					<a
						href={industryPath(industry.slug)}
						class="mizo-card group relative flex h-full flex-col overflow-hidden rounded-sm border border-ink/10 bg-surface hover:-translate-y-1 hover:border-accent/70"
					>
						<div class="relative aspect-[4/3] overflow-hidden">
							<Image
								src={industryMedia[industry.slug].hero}
								alt=""
								class="absolute inset-0 h-full w-full object-cover transition-all duration-300 group-hover:scale-[1.03]"
								widths={[640, 960, 1280]}
								sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
								format="webp"
								quality={74}
								loading="lazy"
							/>
						</div>
						<div class="px-5 py-5 sm:px-7 sm:py-8">
							<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">{industry.nav}</p>
							<h3 class="mt-3 text-xl font-extrabold leading-snug text-ink">{industry.title}</h3>
							<p class="mt-3 text-base leading-7 text-ink/75">{industry.short}</p>
						</div>
						<span class="pointer-events-none absolute inset-0 bg-accent/0 transition-all duration-300 group-hover:bg-accent/10" aria-hidden="true"></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="mizo-band mizo-band-white border-t border-ink/10 py-12 sm:py-20" aria-labelledby="marcas-heading">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="mizo-kicker">Marcas</p>
					<h2 id="marcas-heading" class="mt-3 text-3xl font-extrabold leading-tight text-ink sm:text-4xl">Marcas que instalamos</h2>
				</div>
				<div class="flex shrink-0 gap-2">
					<button type="button" class="brand-carousel-btn" data-brand-prev aria-label="Marca anterior">
						<svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</button>
					<button type="button" class="brand-carousel-btn" data-brand-next aria-label="Marca siguiente">
						<svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</button>
				</div>
			</div>
			<div class="brand-carousel mt-8" data-brand-carousel>
				<ul class="brand-carousel-track">
					{BRANDS.map((brand) => (
						<li class="brand-carousel-slide">
							<img
								src={`/images/marcas/${brand.slug}.svg`}
								alt={brand.name}
								class="h-14 w-auto max-w-[11rem] object-contain"
								loading="lazy"
							/>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="mizo-band mizo-band-gray border-t border-ink/10 py-12 sm:py-20" aria-labelledby="clientes-heading">
		<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Clientes</p>
			<h2 id="clientes-heading" class="mt-3 text-3xl font-extrabold leading-tight text-ink sm:text-4xl">Nuestros clientes</h2>
		</div>
		<div class="client-marquee mt-8" aria-label="Logos de clientes">
			<ul class="client-marquee-track">
				{CLIENTS.map((client) => (
					<li class="client-marquee-item">
						<img src={client.src} alt={client.name} width="180" height="64" loading="lazy" />
					</li>
				))}
				{CLIENTS.map((client) => (
					<li class="client-marquee-item" data-clone aria-hidden="true">
						<img src={client.src} alt="" width="180" height="64" loading="lazy" />
					</li>
				))}
			</ul>
		</div>
	</section>

	<ConversionCta />
</Layout>

<script>
	const carousel = document.querySelector('[data-brand-carousel]');
	const track = carousel?.querySelector('.brand-carousel-track');
	const prev = document.querySelector('[data-brand-prev]');
	const next = document.querySelector('[data-brand-next]');

	if (track instanceof HTMLElement) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const step = () => {
			const item = track.querySelector('li');
			if (!(item instanceof HTMLElement)) return track.clientWidth;
			const gap = Number.parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
			return item.getBoundingClientRect().width + gap;
		};
		const go = (direction) => {
			const distance = step() * direction;
			const max = track.scrollWidth - track.clientWidth;
			if (direction > 0 && track.scrollLeft + distance >= max - 4) {
				track.scrollTo({ left: 0, behavior: 'smooth' });
				return;
			}
			if (direction < 0 && track.scrollLeft <= 4) {
				track.scrollTo({ left: max, behavior: 'smooth' });
				return;
			}
			track.scrollBy({ left: distance, behavior: 'smooth' });
		};

		let timer = 0;
		const play = () => {
			window.clearInterval(timer);
			if (reduced || track.scrollWidth <= track.clientWidth + 8) return;
			timer = window.setInterval(() => go(1), 3200);
		};
		const pause = () => window.clearInterval(timer);

		prev?.addEventListener('click', () => {
			pause();
			go(-1);
			play();
		});
		next?.addEventListener('click', () => {
			pause();
			go(1);
			play();
		});
		carousel?.addEventListener('mouseenter', pause);
		carousel?.addEventListener('mouseleave', play);
		carousel?.addEventListener('focusin', pause);
		carousel?.addEventListener('focusout', play);
		track.addEventListener('touchstart', pause, { passive: true });
		track.addEventListener('touchend', play, { passive: true });
		play();
	}
</script>
