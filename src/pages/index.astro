---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ConversionCta from '../components/ConversionCta.astro';
import heroImage from '../assets/hero-instalacion.jpg';
import { INDUSTRIES } from '../lib/industries';
import { industryMedia } from '../lib/industry-images';
import { BRANDS, SITE } from '../lib/site';
import { absoluteUrl, graphSchema, localBusinessSchema, organizationSchema, webPageSchema, websiteSchema } from '../lib/seo';

const jsonLd = graphSchema([
	organizationSchema(),
	localBusinessSchema(),
	websiteSchema(),
	webPageSchema({
		name: SITE.title,
		description: SITE.description,
		url: absoluteUrl('/'),
	}),
]);

---

<Layout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
	<section class="relative isolate flex min-h-[80vh] items-end overflow-hidden bg-charcoal pt-32 text-white sm:min-h-[85vh] sm:pt-36">
		<Image
			src={heroImage}
			alt="Instalación profesional de audio y video en un recinto"
			class="absolute inset-0 h-full w-full object-cover"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			format="webp"
			quality={78}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/80 to-charcoal/35"></div>
		<div class="relative mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8 lg:pb-24">
			<p class="mizo-kicker">Mizo</p>
			<h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-6xl lg:text-5xl">El recinto define la instalación.</h1>
			<p class="mt-5 max-w-xl text-lg leading-8 text-white/85">
				Audio, imagen y control en {SITE.areas.join(', ')}. Elige el rubro y abre su página.
			</p>
			<a href="/industrias" class="mizo-btn mt-8 w-fit">Ver soluciones</a>
		</div>
	</section>

	<section class="bg-charcoal py-20 sm:py-28" aria-labelledby="rubros-heading">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Rubros</p>
			<h2 id="rubros-heading" class="mt-3 max-w-2xl text-3xl font-extrabold leading-tight text-white sm:text-4xl">
				Cada recinto, con su propio sistema.
			</h2>
			<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-8">
				{INDUSTRIES.map((industry) => (
					<article class="mizo-card group overflow-hidden rounded-sm border border-white/10 bg-charcoal hover:border-accent/50">
						<div class="relative aspect-[4/3] overflow-hidden">
							<Image
								src={industryMedia[industry.slug].hero}
								alt={industry.imageLabel}
								class="absolute inset-0 h-full w-full object-cover transition-all duration-300 group-hover:scale-[1.03]"
								widths={[640, 960, 1280]}
								sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
								format="webp"
								quality={74}
								loading="lazy"
							/>
						</div>
						<div class="px-6 py-7 sm:px-7 sm:py-8">
							<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">{industry.nav}</p>
							<h3 class="mt-3 text-xl font-extrabold leading-snug text-white">{industry.title}</h3>
							<p class="mt-3 text-sm leading-7 text-white/80">{industry.short}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="border-t border-white/10 bg-charcoal py-16 sm:py-24" aria-label="Marcas">
		<ul class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-white/10 sm:grid-cols-4 lg:grid-cols-7">
			{BRANDS.map((brand) => (
				<li class="flex h-20 items-center justify-center bg-charcoal px-4">
					<img
						src={`/images/marcas/${brand.slug}.svg`}
						alt={brand.name}
						class="max-h-8 max-w-[110px] object-contain brightness-0 invert opacity-80"
						width="110"
						height="32"
						loading="lazy"
					/>
				</li>
			))}
		</ul>
	</section>

	<ConversionCta />
</Layout>
