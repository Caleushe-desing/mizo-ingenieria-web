---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/hero-instalacion.jpg';
import imgSonido from '../assets/servicio-sonido.jpg';
import imgVideo from '../assets/servicio-video.jpg';
import imgCctv from '../assets/servicio-cctv.jpg';
import imgTi from '../assets/servicio-ti.jpg';
import { BRANDS, SERVICES, SITE, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, localBusinessSchema, organizationSchema, webPageSchema, websiteSchema } from '../lib/seo';

const serviceImages = {
	sonido: imgSonido,
	video: imgVideo,
	cctv: imgCctv,
	ti: imgTi,
} as const;

const jsonLd = graphSchema([
	organizationSchema(),
	localBusinessSchema(),
	websiteSchema(),
	webPageSchema({
		name: SITE.title,
		description: SITE.description,
		url: absoluteUrl('/'),
	}),
]);
---

<Layout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
	<section class="relative isolate overflow-hidden bg-charcoal pt-28 text-white sm:pt-32">
		<Image
			src={heroImage}
			alt="Instalación profesional de audio y video en un recinto en Chile"
			class="absolute inset-0 h-full w-full object-cover"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			format="webp"
			quality={78}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/80 to-charcoal/35"></div>
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Ingeniería y tecnología en Chile</p>
			<h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
				Sonido, video, seguridad y soporte TI.<br class="hidden sm:block" /> Instalado y respaldado.
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">
				Diseñamos e instalamos soluciones profesionales para empresas, instituciones y recintos en Frutillar, Santiago y el sur de Chile.
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row">
				<a href="/contacto" class="mizo-btn">Solicitar cotización</a>
				<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="mizo-btn-ghost">WhatsApp</a>
			</div>
			<div class="mt-10 grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-3">
				<div class="bg-charcoal/80 px-5 py-4 backdrop-blur-sm">
					<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Cobertura</p>
					<p class="mt-2 text-sm font-semibold">Frutillar, Santiago y sur de Chile</p>
				</div>
				<div class="bg-charcoal/80 px-5 py-4 backdrop-blur-sm">
					<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Enfoque</p>
					<p class="mt-2 text-sm font-semibold">Instalación, calibración y soporte</p>
				</div>
				<div class="bg-charcoal/80 px-5 py-4 backdrop-blur-sm">
					<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Contacto</p>
					<p class="mt-2 text-sm font-semibold">{SITE.phoneDisplay}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="relative border-t border-white/10 bg-charcoal py-16 sm:py-20" aria-labelledby="servicios-heading">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.05]"></div>
		<div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl">
				<p class="mizo-kicker">Servicios</p>
				<h2 id="servicios-heading" class="mt-3 text-3xl font-extrabold sm:text-4xl">Cuatro líneas. Un solo equipo técnico.</h2>
				<p class="mt-4 text-base leading-7 text-white/65">
					Elige el servicio que necesitas. Cada proyecto se dimensiona, instala y deja operativo.
				</p>
			</div>

			<div class="mt-10 grid gap-px bg-white/10 lg:grid-cols-2">
				{SERVICES.map((service) => (
					<a href={service.href} class="group flex flex-col bg-charcoal transition hover:bg-charcoal-light">
						<div class="aspect-[16/9] overflow-hidden">
							<Image
								src={serviceImages[service.id]}
								alt={service.title}
								class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
								widths={[400, 720, 960]}
								sizes="(min-width: 1024px) 50vw, 100vw"
								format="webp"
								quality={72}
								loading="lazy"
							/>
						</div>
						<div class="flex flex-1 flex-col p-6">
							<h3 class="text-xl font-bold group-hover:text-orange">{service.title}</h3>
							<p class="mt-2 text-sm leading-6 text-white/60">{service.short}</p>
							<ul class="mt-4 space-y-2 text-sm text-white/80">
								{service.works.map((work) => (
									<li class="flex gap-3">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 bg-orange"></span>
										<span>{work}</span>
									</li>
								))}
							</ul>
							<span class="mt-auto pt-5 inline-flex text-sm font-bold uppercase tracking-[0.12em] text-orange">Ver servicio</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="border-t border-white/10 bg-charcoal-light/30 py-14" aria-labelledby="marcas-heading">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div>
				<p class="mizo-kicker">Confianza</p>
				<h2 id="marcas-heading" class="mt-3 text-2xl font-extrabold sm:text-3xl">Integramos marcas de prestigio</h2>
				<p class="mt-3 max-w-2xl text-sm leading-6 text-white/60">
					Trabajamos con tecnología profesional de audio, video y proyección para instalaciones duraderas.
				</p>
			</div>
			<ul class="mt-10 grid grid-cols-2 gap-px bg-white/10 sm:grid-cols-4 lg:grid-cols-7">
				{BRANDS.map((brand) => (
					<li class="flex h-20 items-center justify-center bg-charcoal px-4">
						<img
							src={`/images/marcas/${brand.slug}.svg`}
							alt={brand.name}
							class="max-h-8 max-w-[110px] object-contain brightness-0 invert opacity-80"
							width="110"
							height="32"
							loading="lazy"
						/>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="border-t border-white/10 bg-charcoal py-16">
		<div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
			<div>
				<h2 class="text-2xl font-extrabold sm:text-3xl">¿Tienes un recinto que equipar?</h2>
				<p class="mt-2 max-w-xl text-white/65">Cuéntanos el espacio y te respondemos con una propuesta clara.</p>
			</div>
			<div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
				<a href="/contacto" class="mizo-btn">Cotizar ahora</a>
				<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="mizo-btn-ghost">WhatsApp</a>
			</div>
		</div>
	</section>
</Layout>
