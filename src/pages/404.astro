---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Mizo" description="El enlace no existe. Vuelve al inicio o contáctanos." noindex={true}>
	<section class="relative overflow-hidden px-4 pb-28 pt-28 text-center sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-xl">
			<p class="mizo-kicker">Error 404</p>
			<h1 class="mt-4 text-4xl font-extrabold">Página no encontrada</h1>
			<p class="mt-4 text-white/80">El enlace puede estar desactualizado. Vuelve al inicio o escríbenos.</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href="/" class="mizo-btn">Inicio</a>
				<a href="/contacto" class="mizo-btn-ghost">Contacto</a>
			</div>
		</div>
	</section>
</Layout>
