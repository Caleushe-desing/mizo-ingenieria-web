---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Página no encontrada | Mizo"
	description="La página que buscas no existe o fue movida. Vuelve al inicio o contáctanos para ayudarte."
	noindex={true}
>
	<section class="flex min-h-[70vh] items-center justify-center bg-slate-50 px-4 py-20">
		<div class="max-w-xl text-center">
			<p class="text-sm font-black uppercase tracking-[0.2em] text-accent-main">Error 404</p>
			<h1 class="mt-4 text-4xl font-black text-slate-950">Página no encontrada</h1>
			<p class="mt-4 text-base leading-7 text-slate-600">
				El enlace puede estar desactualizado. Puedes volver al inicio, ver nuestros servicios o escribirnos directamente.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/" class="rounded-full bg-accent-main px-5 py-3 text-sm font-black text-white hover:bg-accent-hover">
					Ir al inicio
				</a>
				<a href="/servicios" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-black text-slate-700 hover:bg-slate-100">
					Ver servicios
				</a>
				<a href="/contacto" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-black text-slate-700 hover:bg-slate-100">
					Contacto
				</a>
			</div>
		</div>
	</section>
</Layout>
