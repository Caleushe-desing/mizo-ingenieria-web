---
import ConversionCta from '../components/ConversionCta.astro';
import Layout from '../layouts/Layout.astro';
import { content } from '../lib/content';
import { SITE, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../lib/seo';

const page = content.pages.equipos;
const title = page.seoTitle;
const description = page.seoDescription;
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/equipos') }),
	])}
>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-7xl px-4 pb-14 sm:px-6 sm:pb-16 lg:px-8">
			<p class="mizo-kicker">{page.kicker}</p>
			<h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.1] sm:text-5xl">{page.title}</h1>
			{page.lead && page.lead !== '-' && (
				<p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">
					{page.lead}
				</p>
			)}
		</div>
	</section>

	<section
		id="vitrina"
		class="bg-charcoal py-12 sm:py-16"
		data-endpoint="/crm/api/productos-visibles.php"
		data-whatsapp={SITE.whatsapp}
		aria-labelledby="vitrina-heading"
	>
		<div class="mx-auto max-w-[90rem] px-3 sm:px-5 lg:px-8">
			<h2 id="vitrina-heading" class="sr-only">Productos visibles</h2>
			<div id="vitrina-filtros" class="mb-6 hidden">
				<label class="block">
					<span class="sr-only">Buscar productos</span>
					<input
						id="vitrina-buscar"
						type="search"
						placeholder="Buscar por nombre, SKU o descripción"
						autocomplete="off"
						class="w-full border border-white/15 bg-transparent px-4 py-3 text-sm text-white outline-none placeholder:text-white/40 focus:border-orange"
					/>
				</label>
				<div id="vitrina-categorias" class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Categorías"></div>
				<p id="vitrina-conteo" class="mt-3 text-xs tracking-[0.14em] text-white/40" aria-live="polite"></p>
			</div>
			<p id="vitrina-estado" class="text-sm text-white/60">Cargando productos…</p>
			<div id="vitrina-lista"></div>
			<noscript>
				<p class="text-sm text-white/60">Para ver los productos activos, abre esta página con JavaScript o escríbenos por WhatsApp.</p>
			</noscript>
		</div>
	</section>

	<ConversionCta
		title="¿Necesitas ayuda para elegir?"
		text="Cuéntanos el espacio. Te proponemos el producto que corresponde y lo dejamos instalado."
		whatsappHref={whatsappUrl('Hola Mizo, quiero cotizar un producto para mi recinto.')}
	/>
</Layout>

<script>
	const root = document.getElementById('vitrina');
	const status = document.getElementById('vitrina-estado');
	const list = document.getElementById('vitrina-lista');

	function node(tag, className, text) {
		const element = document.createElement(tag);
		if (className) element.className = className;
		if (text) element.textContent = text;
		return element;
	}

	let closeActive = null;

	function mountOverlay(label) {
		if (closeActive) closeActive();
		const overlay = node('div', 'fixed inset-0 z-[70] flex items-center justify-center bg-charcoal/95 p-4');
		overlay.setAttribute('role', 'dialog');
		overlay.setAttribute('aria-modal', 'true');
		overlay.setAttribute('aria-label', label);
		const previous = document.activeElement;
		const keys = { fn: null };
		document.body.style.overflow = 'hidden';
		function close() {
			document.removeEventListener('keydown', onKey);
			overlay.remove();
			document.body.style.overflow = '';
			if (closeActive === close) closeActive = null;
			if (previous instanceof HTMLElement) previous.focus();
		}
		function onKey(event) {
			if (event.key === 'Escape') close();
			else keys.fn?.(event);
		}
		overlay.addEventListener('click', (event) => {
			if (event.target === overlay) close();
		});
		document.addEventListener('keydown', onKey);
		document.body.append(overlay);
		closeActive = close;
		return { overlay, close, keys };
	}

	function chevron(direction) {
		return `<svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="${direction}" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
	}

	function roundButton(label, symbol, className) {
		const button = node('button', className);
		button.type = 'button';
		button.setAttribute('aria-label', label);
		button.innerHTML = symbol;
		return button;
	}

	function openViewer(photos, alt, start, onIndex) {
		let index = start;
		const { overlay, close, keys } = mountOverlay(alt);
		const sheet = node('div', 'flex w-full max-w-6xl flex-col items-center');
		const stage = node('div', 'relative flex h-[min(68vh,48rem)] w-full items-center justify-center bg-white');
		const img = document.createElement('img');
		img.className = 'h-full w-full object-contain';
		img.alt = alt;
		stage.append(img);
		const counter = node('p', 'mt-3 text-[11px] tracking-[0.18em] text-white/60');
		function show(next) {
			index = (next + photos.length) % photos.length;
			img.src = photos[index];
			counter.textContent = index + 1 + ' / ' + photos.length;
			counter.hidden = photos.length < 2;
			onIndex?.(index);
		}
		show(start);
		sheet.append(stage, counter);
		const closeBtn = node('button', 'absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/10 text-xl font-light leading-none text-white/80 transition hover:bg-white hover:text-charcoal', '×');
		closeBtn.type = 'button';
		closeBtn.setAttribute('aria-label', 'Cerrar');
		closeBtn.addEventListener('click', close);
		overlay.append(sheet, closeBtn);
		if (photos.length > 1) {
			const ghost = 'absolute top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/80 backdrop-blur-sm transition hover:bg-white hover:text-charcoal';
			const prev = roundButton('Foto anterior', chevron('M8.5 3.5 5 7l3.5 3.5'), ghost + ' left-3 sm:left-6');
			const next = roundButton('Foto siguiente', chevron('M5.5 3.5 9 7l-3.5 3.5'), ghost + ' right-3 sm:right-6');
			prev.addEventListener('click', () => show(index - 1));
			next.addEventListener('click', () => show(index + 1));
			overlay.append(prev, next);
			keys.fn = (event) => {
				if (event.key === 'ArrowLeft') show(index - 1);
				if (event.key === 'ArrowRight') show(index + 1);
			};
			let startX = 0;
			stage.addEventListener('pointerdown', (event) => {
				startX = event.clientX;
			});
			stage.addEventListener('pointerup', (event) => {
				const delta = event.clientX - startX;
				if (delta > 40) show(index - 1);
				else if (delta < -40) show(index + 1);
			});
		}
		closeBtn.focus();
	}

	function quoteLinks(item, phone) {
		const quote = node('div', 'grid grid-cols-2 gap-1.5');
		const message = `Quiero cotizar el producto ${item.nombre || ''} (SKU ${item.sku || ''}).`;
		const formLink = node('a', 'inline-flex items-center justify-center bg-orange px-2 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.1em] text-white transition-all duration-300 hover:bg-orange-hover', 'Cotizar');
		formLink.href = `/contacto?sku=${encodeURIComponent(item.sku || '')}&mensaje=${encodeURIComponent(message)}`;
		const whatsapp = node('a', 'inline-flex items-center justify-center border border-white/20 px-2 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.1em] text-white transition-all duration-300 hover:border-accent/80 hover:text-white', 'WhatsApp');
		whatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent('Hola Mizo, ' + message)}`;
		whatsapp.target = '_blank';
		whatsapp.rel = 'noopener noreferrer';
		quote.append(formLink, whatsapp);
		return quote;
	}

	function openInfo(item, phone) {
		const { overlay, close } = mountOverlay(item.nombre || 'Información del producto');
		const panel = node('div', 'relative max-h-[min(80vh,40rem)] w-full max-w-xl overflow-y-auto border border-white/10 bg-charcoal px-6 py-6 sm:px-8');
		const closeBtn = node('button', 'absolute right-4 top-4 text-xs font-bold uppercase tracking-[0.14em] text-white/50 transition hover:text-white', 'Cerrar');
		closeBtn.type = 'button';
		closeBtn.addEventListener('click', close);
		panel.append(closeBtn);
		panel.append(node('p', 'pr-16 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange', item.categoria || 'Producto'));
		panel.append(node('h3', 'mt-2 pr-16 text-2xl font-extrabold leading-snug', item.nombre || item.sku));
		if (item.sku) panel.append(node('p', 'mt-2 font-mono text-xs text-white/40', item.sku));
		if (item.descripcion) panel.append(node('p', 'mt-5 whitespace-pre-wrap text-sm leading-7 text-white/75', item.descripcion));
		const quote = quoteLinks(item, phone);
		quote.classList.add('mt-6');
		panel.append(quote);
		overlay.append(panel);
		closeBtn.focus();
	}

	function gallery(photos, alt) {
		const wrap = node('div', 'bg-white');
		const frame = node('div', 'relative flex aspect-square items-center justify-center overflow-hidden bg-white touch-pan-y');
		const img = document.createElement('img');
		img.className = 'h-full w-full object-contain p-3';
		img.alt = alt;
		img.loading = 'lazy';
		img.decoding = 'async';
		img.src = photos[0];
		img.addEventListener('error', () => {
			img.style.display = 'none';
			const fallback = node('div', 'flex h-full w-full items-center justify-center text-[10px] uppercase tracking-[0.16em] text-charcoal/35', 'Sin foto');
			frame.append(fallback);
		});
		const zoom = node('button', 'absolute inset-0 cursor-zoom-in');
		zoom.type = 'button';
		zoom.setAttribute('aria-label', 'Ver foto en grande');
		zoom.append(img);
		frame.append(zoom);
		wrap.append(frame);

		let index = 0;
		let startX = 0;
		let suppressClick = false;
		const counter = node('span', 'pointer-events-none absolute bottom-2 left-1/2 z-10 -translate-x-1/2 text-[10px] tracking-[0.16em] text-charcoal/45');
		function show(next) {
			index = (next + photos.length) % photos.length;
			img.style.display = '';
			img.src = photos[index];
			if (photos.length > 1) counter.textContent = index + 1 + ' / ' + photos.length;
		}
		show(0);
		zoom.addEventListener('click', () => {
			if (suppressClick) {
				suppressClick = false;
				return;
			}
			openViewer(photos, alt, index, show);
		});
		if (photos.length < 2) return wrap;

		function arrow(label, symbol) {
			const button = node('button', 'absolute top-1/2 z-10 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full border border-black/10 bg-white/85 text-charcoal/70 backdrop-blur-sm transition hover:bg-white hover:text-charcoal');
			button.type = 'button';
			button.setAttribute('aria-label', label);
			button.innerHTML = symbol;
			return button;
		}
		const prev = arrow('Foto anterior', chevron('M8.5 3.5 5 7l3.5 3.5'));
		prev.classList.add('left-2');
		prev.addEventListener('click', () => show(index - 1));
		const next = arrow('Foto siguiente', chevron('M5.5 3.5 9 7l-3.5 3.5'));
		next.classList.add('right-2');
		next.addEventListener('click', () => show(index + 1));
		frame.append(prev, next, counter);

		frame.addEventListener('pointerdown', (event) => {
			const hit = event.target.closest('button');
			if (hit && hit !== zoom) return;
			startX = event.clientX;
		});
		frame.addEventListener('pointerup', (event) => {
			const hit = event.target.closest('button');
			if (hit && hit !== zoom) return;
			const delta = event.clientX - startX;
			if (Math.abs(delta) > 40) {
				suppressClick = true;
				show(delta > 0 ? index - 1 : index + 1);
			}
		});
		return wrap;
	}

	function productPhotos(item) {
		if (!Array.isArray(item.imagenes)) return [];
		return item.imagenes
			.filter((src) => typeof src === 'string' && src !== '')
			.map((src) => {
				if (src.startsWith('/')) return src;
				if (src.startsWith('crm/')) return '/' + src;
				if (src.startsWith('uploads/productos/')) return '/crm/' + src;
				return src;
			})
			.filter((src) => /\/crm\/uploads\/productos\//i.test(src));
	}

	function card(item, phone) {
		const article = node('article', 'group flex flex-col overflow-hidden border border-white/10 bg-charcoal transition-all duration-300 hover:border-orange/50 hover:shadow-[0_8px_24px_rgba(0,0,0,0.35)]');
		const photos = productPhotos(item);
		const alt = item.nombre || item.sku || 'Producto';
		if (photos.length) article.append(gallery(photos, alt));
		else {
			const placeholder = node('div', 'flex aspect-square items-center justify-center bg-white/5 text-[10px] uppercase tracking-[0.16em] text-white/30', 'Sin foto');
			article.append(placeholder);
		}
		const body = node('div', 'flex flex-1 flex-col px-3 py-3 sm:px-3.5 sm:py-4');
		body.append(node('p', 'text-[0.6rem] font-bold uppercase tracking-[0.16em] text-orange', item.categoria || 'Producto'));
		body.append(node('h3', 'mt-1.5 line-clamp-2 min-h-[2.5rem] text-sm font-bold leading-snug text-white', item.nombre || item.sku));
		if (item.sku) body.append(node('p', 'mt-1 font-mono text-[10px] text-white/35', item.sku));
		if (item.descripcion) {
			body.append(node('p', 'mt-2 line-clamp-2 text-xs leading-5 text-white/60', item.descripcion));
			const more = node('button', 'mt-2 self-start text-[10px] font-bold uppercase tracking-[0.12em] text-orange transition hover:text-white', 'Ver más');
			more.type = 'button';
			more.addEventListener('click', () => openInfo(item, phone));
			body.append(more);
		}
		const quote = quoteLinks(item, phone);
		quote.classList.add('mt-auto', 'pt-3');
		body.append(quote);
		article.append(body);
		return article;
	}

	function fold(value) {
		return String(value || '')
			.normalize('NFD')
			.replace(/\p{M}/gu, '')
			.toLowerCase();
	}

	if (root && status && list) {
		const phone = root.dataset.whatsapp || '';
		const filters = document.getElementById('vitrina-filtros');
		const search = document.getElementById('vitrina-buscar');
		const categories = document.getElementById('vitrina-categorias');
		const count = document.getElementById('vitrina-conteo');
		const chipOn = 'border border-orange bg-orange px-3 py-2 text-xs font-bold uppercase tracking-[0.14em] text-white';
		const chipOff = 'border border-white/15 bg-transparent px-3 py-2 text-xs font-bold uppercase tracking-[0.14em] text-white/80 transition-all duration-300 hover:border-accent/60 hover:text-white hover:shadow-glow';
		let products = [];
		let query = '';
		let category = '';

		function matches(item) {
			if (category && fold(item.categoria) !== category) return false;
			if (!query) return true;
			const haystack = fold([item.nombre, item.sku, item.descripcion, item.categoria].filter(Boolean).join(' '));
			return query.split(/\s+/).filter(Boolean).every((word) => haystack.includes(word));
		}

		function render() {
			const visible = products.filter(matches);
			list.replaceChildren();
			if (count) {
				count.textContent = visible.length === 1 ? '1 producto' : visible.length + ' productos';
			}
			if (visible.length === 0) {
				status.hidden = false;
				status.textContent = 'Ningún producto coincide con esa búsqueda.';
				return;
			}
			status.hidden = true;
			const grid = node('div', 'grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5 lg:gap-4');
			for (const item of visible) grid.append(card(item, phone));
			list.append(grid);
		}

		function paintChips(names) {
			if (!categories) return;
			categories.replaceChildren();
			const options = ['', ...names];
			for (const name of options) {
				const button = node('button', name === category || (name === '' && category === '') ? chipOn : chipOff, name || 'Todos');
				button.type = 'button';
				button.setAttribute('aria-pressed', name === category || (name === '' && category === '') ? 'true' : 'false');
				button.addEventListener('click', () => {
					category = fold(name);
					for (const chip of categories.querySelectorAll('button')) {
						const on = chip === button;
						chip.className = on ? chipOn : chipOff;
						chip.setAttribute('aria-pressed', on ? 'true' : 'false');
					}
					render();
				});
				categories.append(button);
			}
		}

		const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
		const timer = controller ? setTimeout(() => controller.abort(), 20000) : 0;
		fetch(root.dataset.endpoint || '/crm/api/productos-visibles.php', {
			headers: { Accept: 'application/json' },
			signal: controller ? controller.signal : undefined,
			credentials: 'same-origin',
		})
			.then((response) => {
				if (!response.ok) throw new Error('catalogo');
				return response.json();
			})
			.then((data) => {
				products = Array.isArray(data?.productos) ? data.productos : [];
				if (products.length === 0) {
					status.textContent = 'Todavía no hay productos publicados. Cuéntanos el recinto y te proponemos el hardware.';
					return;
				}
				const names = [...new Set(products.map((item) => String(item.categoria || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));
				if (names.length > 1) paintChips(names);
				else categories?.remove();
				if (filters) filters.classList.remove('hidden');
				if (search instanceof HTMLInputElement) {
					search.addEventListener('input', () => {
						query = fold(search.value.trim());
						render();
					});
				}
				render();
			})
			.catch(() => {
				status.textContent = 'No se pudo cargar el catálogo. Recarga la página o escríbenos por WhatsApp.';
			})
			.finally(() => {
				if (timer) clearTimeout(timer);
			});
	}
</script>
