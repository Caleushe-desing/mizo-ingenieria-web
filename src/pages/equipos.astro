---
import ConversionCta from '../components/ConversionCta.astro';
import Layout from '../layouts/Layout.astro';
import { SITE, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../lib/seo';

const title = 'Equipos | Mizo — Hardware de grado profesional';
const description =
	'Equipos de audio, video y automatización que Mizo integra en cada recinto. Referencia técnica, sin precios de tienda.';
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/equipos') }),
	])}
>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Equipos</p>
			<h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.1] sm:text-5xl">Componentes de grado profesional, elegidos para integrar.</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-white/65">
				Tres equipos por fila. Toca la foto para verla en grande y abre Información completa para leer la ficha.
			</p>
		</div>
	</section>

	<section
		id="vitrina"
		class="bg-charcoal py-16 sm:py-20"
		data-endpoint="/crm/api/productos-visibles.php"
		data-whatsapp={SITE.whatsapp}
		aria-labelledby="vitrina-heading"
	>
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<h2 id="vitrina-heading" class="sr-only">Equipos visibles</h2>
			<p id="vitrina-estado" class="text-sm text-white/60">Cargando equipos…</p>
			<div id="vitrina-lista"></div>
			<noscript>
				<p class="text-sm text-white/60">Para ver los equipos activos, abre esta página con JavaScript o escríbenos por WhatsApp.</p>
			</noscript>
		</div>
	</section>

	<ConversionCta
		title="¿El equipo depende del recinto?"
		text="Cuéntanos el espacio. Te proponemos el componente que corresponde y lo dejamos instalado."
		whatsappHref={whatsappUrl('Hola Mizo, quiero cotizar un equipo para mi recinto.')}
	/>
</Layout>

<script>
	const root = document.getElementById('vitrina');
	const status = document.getElementById('vitrina-estado');
	const list = document.getElementById('vitrina-lista');

	function node(tag, className, text) {
		const element = document.createElement(tag);
		if (className) element.className = className;
		if (text) element.textContent = text;
		return element;
	}

	let closeActive = null;

	function mountOverlay(label) {
		if (closeActive) closeActive();
		const overlay = node('div', 'fixed inset-0 z-[70] flex items-center justify-center bg-charcoal/95 p-4');
		overlay.setAttribute('role', 'dialog');
		overlay.setAttribute('aria-modal', 'true');
		overlay.setAttribute('aria-label', label);
		const previous = document.activeElement;
		const keys = { fn: null };
		document.body.style.overflow = 'hidden';
		function close() {
			document.removeEventListener('keydown', onKey);
			overlay.remove();
			document.body.style.overflow = '';
			if (closeActive === close) closeActive = null;
			if (previous instanceof HTMLElement) previous.focus();
		}
		function onKey(event) {
			if (event.key === 'Escape') close();
			else keys.fn?.(event);
		}
		overlay.addEventListener('click', (event) => {
			if (event.target === overlay) close();
		});
		document.addEventListener('keydown', onKey);
		document.body.append(overlay);
		closeActive = close;
		return { overlay, close, keys };
	}

	function chevron(direction) {
		return `<svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="${direction}" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
	}

	function roundButton(label, symbol, className) {
		const button = node('button', className);
		button.type = 'button';
		button.setAttribute('aria-label', label);
		button.innerHTML = symbol;
		return button;
	}

	function openViewer(photos, alt, start, onIndex) {
		let index = start;
		const { overlay, close, keys } = mountOverlay(alt);
		const img = document.createElement('img');
		img.className = 'max-h-[82vh] max-w-[92vw] bg-white object-contain';
		img.alt = alt;
		const counter = node('span', 'pointer-events-none absolute bottom-5 left-1/2 -translate-x-1/2 text-[11px] tracking-[0.18em] text-white/55');
		function show(next) {
			index = (next + photos.length) % photos.length;
			img.src = photos[index];
			counter.textContent = index + 1 + ' / ' + photos.length;
			counter.hidden = photos.length < 2;
			onIndex?.(index);
		}
		show(start);
		const closeBtn = node('button', 'absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/10 text-xl font-light leading-none text-white/80 transition hover:bg-white hover:text-charcoal', '×');
		closeBtn.type = 'button';
		closeBtn.setAttribute('aria-label', 'Cerrar');
		closeBtn.addEventListener('click', close);
		overlay.append(img, closeBtn, counter);
		if (photos.length > 1) {
			const ghost = 'absolute top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/80 backdrop-blur-sm transition hover:bg-white hover:text-charcoal';
			const prev = roundButton('Foto anterior', chevron('M8.5 3.5 5 7l3.5 3.5'), ghost + ' left-3 sm:left-6');
			const next = roundButton('Foto siguiente', chevron('M5.5 3.5 9 7l-3.5 3.5'), ghost + ' right-3 sm:right-6');
			prev.addEventListener('click', () => show(index - 1));
			next.addEventListener('click', () => show(index + 1));
			overlay.append(prev, next);
			keys.fn = (event) => {
				if (event.key === 'ArrowLeft') show(index - 1);
				if (event.key === 'ArrowRight') show(index + 1);
			};
			let startX = 0;
			overlay.addEventListener('pointerdown', (event) => {
				if (event.target.closest('button')) return;
				startX = event.clientX;
			});
			overlay.addEventListener('pointerup', (event) => {
				if (event.target.closest('button')) return;
				const delta = event.clientX - startX;
				if (delta > 40) show(index - 1);
				else if (delta < -40) show(index + 1);
			});
		}
		closeBtn.focus();
	}

	function quoteLinks(item, phone) {
		const quote = node('div', 'grid grid-cols-2 gap-2');
		const message = `Quiero cotizar el equipo ${item.nombre || ''} (SKU ${item.sku || ''}).`;
		const formLink = node('a', 'inline-flex items-center justify-center bg-orange px-3 py-3 text-center text-xs font-bold uppercase tracking-[0.12em] text-white transition hover:bg-orange-hover', 'Formulario');
		formLink.href = `/contacto?sku=${encodeURIComponent(item.sku || '')}&mensaje=${encodeURIComponent(message)}`;
		const whatsapp = node('a', 'inline-flex items-center justify-center border border-white/20 px-3 py-3 text-center text-xs font-bold uppercase tracking-[0.12em] text-white transition hover:border-orange hover:text-orange', 'WhatsApp');
		whatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent('Hola Mizo, ' + message)}`;
		whatsapp.target = '_blank';
		whatsapp.rel = 'noopener noreferrer';
		quote.append(formLink, whatsapp);
		return quote;
	}

	function openInfo(item, phone) {
		const { overlay, close } = mountOverlay(item.nombre || 'Información del equipo');
		const panel = node('div', 'relative max-h-[min(80vh,40rem)] w-full max-w-xl overflow-y-auto border border-white/10 bg-charcoal px-6 py-6 sm:px-8');
		const closeBtn = node('button', 'absolute right-4 top-4 text-xs font-bold uppercase tracking-[0.14em] text-white/50 transition hover:text-white', 'Cerrar');
		closeBtn.type = 'button';
		closeBtn.addEventListener('click', close);
		panel.append(closeBtn);
		panel.append(node('p', 'pr-16 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange', item.categoria || 'Equipo'));
		panel.append(node('h3', 'mt-2 pr-16 text-2xl font-extrabold leading-snug', item.nombre || item.sku));
		if (item.sku) panel.append(node('p', 'mt-2 font-mono text-xs text-white/40', item.sku));
		if (item.descripcion) panel.append(node('p', 'mt-5 whitespace-pre-wrap text-sm leading-7 text-white/75', item.descripcion));
		const quote = quoteLinks(item, phone);
		quote.classList.add('mt-6');
		panel.append(quote);
		overlay.append(panel);
		closeBtn.focus();
	}

	function gallery(photos, alt) {
		const frame = node('div', 'relative aspect-square overflow-hidden bg-white touch-pan-y');
		const img = document.createElement('img');
		img.className = 'h-full w-full object-contain';
		img.alt = alt;
		img.src = photos[0];
		const zoom = node('button', 'absolute inset-0 cursor-zoom-in');
		zoom.type = 'button';
		zoom.setAttribute('aria-label', 'Ver foto en grande');
		zoom.append(img);
		frame.append(zoom);

		let index = 0;
		let startX = 0;
		let suppressClick = false;
		const counter = node('span', 'pointer-events-none absolute bottom-3 left-1/2 z-10 -translate-x-1/2 text-[11px] tracking-[0.18em] text-charcoal/50');
		function show(next) {
			index = (next + photos.length) % photos.length;
			img.src = photos[index];
			if (photos.length > 1) counter.textContent = index + 1 + ' / ' + photos.length;
		}
		show(0);
		zoom.addEventListener('click', () => {
			if (suppressClick) {
				suppressClick = false;
				return;
			}
			openViewer(photos, alt, index, show);
		});
		if (photos.length < 2) return frame;

		function arrow(label, symbol) {
			const button = node('button', 'absolute top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-black/10 bg-white/80 text-charcoal/70 backdrop-blur-sm transition hover:bg-white hover:text-charcoal');
			button.type = 'button';
			button.setAttribute('aria-label', label);
			button.innerHTML = symbol;
			return button;
		}
		const prev = arrow('Foto anterior', chevron('M8.5 3.5 5 7l3.5 3.5'));
		prev.classList.add('left-3');
		prev.addEventListener('click', () => show(index - 1));
		const next = arrow('Foto siguiente', chevron('M5.5 3.5 9 7l-3.5 3.5'));
		next.classList.add('right-3');
		next.addEventListener('click', () => show(index + 1));
		frame.append(prev, next, counter);

		frame.addEventListener('pointerdown', (event) => {
			const hit = event.target.closest('button');
			if (hit && hit !== zoom) return;
			startX = event.clientX;
		});
		frame.addEventListener('pointerup', (event) => {
			const hit = event.target.closest('button');
			if (hit && hit !== zoom) return;
			const delta = event.clientX - startX;
			if (Math.abs(delta) > 40) {
				suppressClick = true;
				show(delta > 0 ? index - 1 : index + 1);
			}
		});
		return frame;
	}

	function card(item, phone) {
		const article = node('article', 'flex flex-col border border-white/10 bg-charcoal');
		const photos = Array.isArray(item.imagenes) ? item.imagenes.filter((src) => typeof src === 'string' && src.startsWith('/crm/uploads/productos/')) : [];
		const alt = item.nombre || item.sku || 'Equipo';
		if (photos.length) article.append(gallery(photos, alt));
		const body = node('div', 'flex flex-1 flex-col px-5 py-5');
		body.append(node('p', 'text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange', item.categoria || 'Equipo'));
		body.append(node('h3', 'mt-2 text-lg font-extrabold leading-snug', item.nombre || item.sku));
		if (item.sku) body.append(node('p', 'mt-2 font-mono text-xs text-white/40', item.sku));
		if (item.descripcion) {
			body.append(node('p', 'mt-3 line-clamp-3 text-sm leading-6 text-white/65', item.descripcion));
			const more = node('button', 'mt-3 self-start text-xs font-bold uppercase tracking-[0.14em] text-orange transition hover:text-white', 'Información completa');
			more.type = 'button';
			more.addEventListener('click', () => openInfo(item, phone));
			body.append(more);
		}
		const quote = quoteLinks(item, phone);
		quote.classList.add('mt-5');
		body.append(quote);
		article.append(body);
		return article;
	}

	if (root && status && list) {
		const phone = root.dataset.whatsapp || '';
		fetch(root.dataset.endpoint || '/crm/api/productos-visibles.php', { headers: { Accept: 'application/json' } })
			.then((response) => {
				if (!response.ok) throw new Error('catalogo');
				return response.json();
			})
			.then((data) => {
				const products = Array.isArray(data.productos) ? data.productos : [];
				if (products.length === 0) {
					status.textContent = 'Todavía no hay equipos publicados. Cuéntanos el recinto y te proponemos el hardware.';
					return;
				}
				status.hidden = true;
				const grid = node('div', 'grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3');
				for (const item of products) grid.append(card(item, phone));
				list.append(grid);
			})
			.catch(() => {
				status.textContent = 'No se pudo cargar el catálogo. Escríbenos y te proponemos el equipo.';
			});
	}
</script>
