---
import ConversionCta from '../components/ConversionCta.astro';
import Layout from '../layouts/Layout.astro';
import { content } from '../lib/content';
import { SITE, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../lib/seo';

const page = content.pages.equipos;
const title = page.seoTitle;
const description = page.seoDescription;
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/equipos') }),
	])}
>
	<section class="relative overflow-hidden border-b border-ink/10 bg-transparent pt-28 text-ink sm:pt-32">
		<div class="pointer-events-none absolute inset-0 bg-surface/35"></div>
		<div class="relative mx-auto max-w-7xl px-4 pb-10 sm:px-6 sm:pb-12 lg:px-8">
			<p class="mizo-kicker">{page.kicker}</p>
			<h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.1] text-ink sm:text-5xl">{page.title}</h1>
			{page.lead && page.lead !== '-' && (
				<p class="mt-4 max-w-2xl text-lg leading-8 text-ink/70">
					{page.lead}
				</p>
			)}
			<p class="mt-3 text-sm text-ink/50">Catálogo técnico de consulta · Sin precios de venta · Cotización a medida</p>
		</div>
	</section>

	<section
		id="vitrina"
		class="bg-transparent py-8 sm:py-10"
		data-endpoint="/crm/api/productos-visibles.php"
		data-whatsapp={SITE.whatsapp}
		aria-labelledby="vitrina-heading"
	>
		<div class="mx-auto max-w-[90rem] px-3 sm:px-5 lg:px-8">
			<h2 id="vitrina-heading" class="sr-only">Catálogo de equipos</h2>

			<div class="shop-layout">
				<aside id="vitrina-aside" class="shop-aside" aria-label="Filtros del catálogo">
					<div class="shop-aside-card">
						<p class="shop-aside-title">Categorías</p>
						<nav id="vitrina-categorias" class="shop-cat-nav" role="navigation" aria-label="Categorías de equipos"></nav>
					</div>
					<div class="shop-aside-card shop-aside-note">
						<p class="text-sm font-semibold text-ink">¿No encuentras el equipo?</p>
						<p class="mt-1 text-sm leading-6 text-ink/65">Te ayudamos a elegir según el recinto y el uso. Sin precios publicados: cotizamos a medida.</p>
						<a href="/contacto" class="mt-3 inline-flex text-sm font-bold text-accent hover:text-accent-hover">Solicitar asesoría →</a>
					</div>
				</aside>

				<div class="shop-main">
					<div id="vitrina-filtros" class="shop-toolbar hidden">
						<label class="shop-search">
							<span class="sr-only">Buscar equipos</span>
							<svg class="shop-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"></circle>
								<path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
							</svg>
							<input
								id="vitrina-buscar"
								type="search"
								placeholder="Buscar por nombre, SKU, categoría o descripción"
								autocomplete="off"
							/>
						</label>
						<div class="shop-toolbar-meta">
							<p id="vitrina-conteo" class="shop-count" aria-live="polite"></p>
							<label class="shop-sort">
								<span class="sr-only">Ordenar</span>
								<select id="vitrina-orden" aria-label="Ordenar equipos">
									<option value="nombre">Nombre A–Z</option>
									<option value="categoria">Categoría</option>
									<option value="sku">SKU</option>
								</select>
							</label>
						</div>
						<div id="vitrina-chips" class="shop-chips" role="group" aria-label="Filtro rápido"></div>
					</div>

					<p id="vitrina-estado" class="text-sm text-ink/55">Cargando catálogo…</p>
					<div id="vitrina-lista"></div>
					<noscript>
						<p class="text-sm text-ink/55">Para ver los equipos, abre esta página con JavaScript o escríbenos por WhatsApp.</p>
					</noscript>
				</div>
			</div>
		</div>
	</section>

	<ConversionCta
		title="¿Necesitas ayuda para elegir?"
		text="Cuéntanos el espacio. Te proponemos el producto que corresponde y lo dejamos instalado."
		whatsappHref={whatsappUrl('Hola Mizo, quiero cotizar un producto para mi recinto.')}
	/>
</Layout>

<style is:global>
	.shop-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}
	@media (min-width: 1024px) {
		.shop-layout {
			grid-template-columns: 240px minmax(0, 1fr);
			gap: 1.75rem;
		}
	}
	.shop-aside {
		display: grid;
		gap: 0.85rem;
	}
	@media (min-width: 1024px) {
		.shop-aside {
			position: sticky;
			top: 5.5rem;
		}
	}
	.shop-aside-card {
		background: #fff;
		border: 1px solid rgba(24, 27, 32, 0.1);
		border-radius: 12px;
		padding: 1rem 1rem 0.85rem;
	}
	.shop-aside-title {
		margin: 0 0 0.75rem;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #0b6ea8;
	}
	.shop-cat-nav {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.shop-cat-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		border: 0;
		background: transparent;
		border-radius: 8px;
		padding: 0.55rem 0.65rem;
		text-align: left;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		color: rgba(24, 27, 32, 0.75);
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.shop-cat-btn:hover {
		background: #e2f3fb;
		color: #0e6491;
	}
	.shop-cat-btn.is-on {
		background: #e2f3fb;
		color: #0e6491;
		box-shadow: inset 3px 0 0 #1c9bd8;
	}
	.shop-cat-count {
		font-size: 0.75rem;
		font-weight: 700;
		color: rgba(24, 27, 32, 0.4);
	}
	.shop-cat-btn.is-on .shop-cat-count {
		color: #1c9bd8;
	}
	.shop-toolbar {
		display: grid;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
		background: #fff;
		border: 1px solid rgba(24, 27, 32, 0.1);
		border-radius: 12px;
		padding: 0.85rem;
	}
	.shop-search {
		position: relative;
		display: block;
	}
	.shop-search-icon {
		position: absolute;
		left: 0.85rem;
		top: 50%;
		transform: translateY(-50%);
		color: rgba(24, 27, 32, 0.4);
		pointer-events: none;
	}
	.shop-search input {
		width: 100%;
		border: 1px solid rgba(24, 27, 32, 0.12);
		border-radius: 10px;
		background: #f8fafc;
		padding: 0.8rem 0.9rem 0.8rem 2.5rem;
		font: inherit;
		font-size: 0.95rem;
		color: #181b20;
		outline: none;
	}
	.shop-search input:focus {
		border-color: #1c9bd8;
		background: #fff;
		box-shadow: 0 0 0 3px rgba(28, 155, 216, 0.15);
	}
	.shop-toolbar-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.shop-count {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: rgba(24, 27, 32, 0.5);
	}
	.shop-sort select {
		border: 1px solid rgba(24, 27, 32, 0.12);
		border-radius: 8px;
		background: #fff;
		padding: 0.45rem 0.7rem;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		color: #181b20;
	}
	.shop-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	@media (min-width: 1024px) {
		.shop-chips { display: none; }
	}
	.shop-chip {
		border: 1px solid rgba(24, 27, 32, 0.12);
		background: #fff;
		border-radius: 999px;
		padding: 0.4rem 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(24, 27, 32, 0.7);
		cursor: pointer;
	}
	.shop-chip.is-on {
		border-color: #f47b20;
		background: #f47b20;
		color: #fff;
	}
	.shop-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}
	@media (min-width: 640px) {
		.shop-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	}
	@media (min-width: 900px) {
		.shop-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}
	@media (min-width: 1100px) {
		.shop-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.9rem; }
	}
	.shop-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #fff;
		border: 1px solid rgba(24, 27, 32, 0.1);
		border-radius: 12px;
		transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
	}
	.shop-card:hover {
		border-color: rgba(28, 155, 216, 0.45);
		box-shadow: 0 12px 28px rgba(15, 17, 20, 0.08);
		transform: translateY(-2px);
	}
	.shop-card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0.85rem 0.9rem 1rem;
	}
	.shop-card-actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 0.85rem;
	}
</style>

<script>
	const root = document.getElementById('vitrina');
	const status = document.getElementById('vitrina-estado');
	const list = document.getElementById('vitrina-lista');

	function node(tag, className, text) {
		const element = document.createElement(tag);
		if (className) element.className = className;
		if (text) element.textContent = text;
		return element;
	}

	let closeActive = null;

	function mountOverlay(label) {
		if (closeActive) closeActive();
		const overlay = node('div', 'fixed inset-0 z-[70] flex items-center justify-center bg-ink/70 p-4 backdrop-blur-[2px]');
		overlay.setAttribute('role', 'dialog');
		overlay.setAttribute('aria-modal', 'true');
		overlay.setAttribute('aria-label', label);
		const previous = document.activeElement;
		const keys = { fn: null };
		document.body.style.overflow = 'hidden';
		function close() {
			document.removeEventListener('keydown', onKey);
			overlay.remove();
			document.body.style.overflow = '';
			if (closeActive === close) closeActive = null;
			if (previous instanceof HTMLElement) previous.focus();
		}
		function onKey(event) {
			if (event.key === 'Escape') close();
			else keys.fn?.(event);
		}
		overlay.addEventListener('click', (event) => {
			if (event.target === overlay) close();
		});
		document.addEventListener('keydown', onKey);
		document.body.append(overlay);
		closeActive = close;
		return { overlay, close, keys };
	}

	function chevron(direction) {
		return `<svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="${direction}" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
	}

	function roundButton(label, symbol, className) {
		const button = node('button', className);
		button.type = 'button';
		button.setAttribute('aria-label', label);
		button.innerHTML = symbol;
		return button;
	}

	function openViewer(photos, alt, start, onIndex) {
		let index = start;
		const { overlay, close, keys } = mountOverlay(alt);
		const sheet = node('div', 'flex w-full max-w-6xl flex-col items-center');
		const stage = node('div', 'relative flex h-[min(68vh,48rem)] w-full items-center justify-center rounded-xl bg-white shadow-card');
		const img = document.createElement('img');
		img.className = 'h-full w-full object-contain';
		img.alt = alt;
		stage.append(img);
		const counter = node('p', 'mt-3 text-[11px] tracking-[0.18em] text-white/90');
		function show(next) {
			index = (next + photos.length) % photos.length;
			img.src = photos[index];
			counter.textContent = index + 1 + ' / ' + photos.length;
			counter.hidden = photos.length < 2;
			onIndex?.(index);
		}
		show(start);
		sheet.append(stage, counter);
		const closeBtn = node('button', 'absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white text-xl font-light leading-none text-ink shadow-card transition hover:bg-orange hover:text-white', '×');
		closeBtn.type = 'button';
		closeBtn.setAttribute('aria-label', 'Cerrar');
		closeBtn.addEventListener('click', close);
		overlay.append(sheet, closeBtn);
		if (photos.length > 1) {
			const ghost = 'absolute top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-ink/10 bg-white text-ink shadow-card transition hover:bg-orange hover:text-white';
			const prev = roundButton('Foto anterior', chevron('M8.5 3.5 5 7l3.5 3.5'), ghost + ' left-3 sm:left-6');
			const next = roundButton('Foto siguiente', chevron('M5.5 3.5 9 7l-3.5 3.5'), ghost + ' right-3 sm:right-6');
			prev.addEventListener('click', () => show(index - 1));
			next.addEventListener('click', () => show(index + 1));
			overlay.append(prev, next);
			keys.fn = (event) => {
				if (event.key === 'ArrowLeft') show(index - 1);
				if (event.key === 'ArrowRight') show(index + 1);
			};
			let startX = 0;
			stage.addEventListener('pointerdown', (event) => { startX = event.clientX; });
			stage.addEventListener('pointerup', (event) => {
				const delta = event.clientX - startX;
				if (delta > 40) show(index - 1);
				else if (delta < -40) show(index + 1);
			});
		}
		closeBtn.focus();
	}

	function quoteLinks(item, phone) {
		const quote = node('div', 'shop-card-actions');
		const message = `Quiero cotizar el producto ${item.nombre || ''} (SKU ${item.sku || ''}).`;
		const formLink = node('a', 'inline-flex items-center justify-center rounded-lg bg-orange px-2 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.1em] text-white transition hover:bg-orange-hover', 'Cotizar');
		formLink.href = `/contacto?sku=${encodeURIComponent(item.sku || '')}&mensaje=${encodeURIComponent(message)}`;
		const whatsapp = node('a', 'inline-flex items-center justify-center rounded-lg border border-ink/15 px-2 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.1em] text-ink transition hover:border-accent hover:text-accent', 'WhatsApp');
		whatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent('Hola Mizo, ' + message)}`;
		whatsapp.target = '_blank';
		whatsapp.rel = 'noopener noreferrer';
		quote.append(formLink, whatsapp);
		return quote;
	}

	function openInfo(item, phone) {
		const { overlay, close } = mountOverlay(item.nombre || 'Información del equipo');
		const panel = node('div', 'relative max-h-[min(80vh,40rem)] w-full max-w-xl overflow-y-auto rounded-xl border border-ink/10 bg-white px-6 py-6 shadow-card sm:px-8');
		const closeBtn = node('button', 'absolute right-4 top-4 text-xs font-bold uppercase tracking-[0.14em] text-ink/40 transition hover:text-ink', 'Cerrar');
		closeBtn.type = 'button';
		closeBtn.addEventListener('click', close);
		panel.append(closeBtn);
		panel.append(node('p', 'pr-16 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange', item.categoria || 'Equipo'));
		panel.append(node('h3', 'mt-2 pr-16 text-2xl font-extrabold leading-snug text-ink', item.nombre || item.sku));
		if (item.sku) panel.append(node('p', 'mt-2 font-mono text-xs text-ink/40', 'SKU ' + item.sku));
		if (item.descripcion) panel.append(node('p', 'mt-5 whitespace-pre-wrap text-sm leading-7 text-ink/70', item.descripcion));
		const note = node('p', 'mt-4 rounded-lg bg-accent-soft px-3 py-2 text-xs leading-5 text-accent-dark', 'Catálogo técnico · Sin precio de lista · Cotización según proyecto');
		panel.append(note);
		const quote = quoteLinks(item, phone);
		quote.classList.add('mt-6');
		panel.append(quote);
		overlay.append(panel);
		closeBtn.focus();
	}

	function gallery(photos, alt) {
		const wrap = node('div', 'bg-white');
		const frame = node('div', 'relative flex aspect-square items-center justify-center overflow-hidden bg-[#f8fafc] touch-pan-y');
		const img = document.createElement('img');
		img.className = 'h-full w-full object-contain p-3';
		img.alt = alt;
		img.loading = 'lazy';
		img.decoding = 'async';
		img.src = photos[0];
		img.addEventListener('error', () => {
			img.style.display = 'none';
			frame.append(node('div', 'flex h-full w-full items-center justify-center text-[10px] uppercase tracking-[0.16em] text-ink/30', 'Sin foto'));
		});
		const zoom = node('button', 'absolute inset-0 cursor-zoom-in');
		zoom.type = 'button';
		zoom.setAttribute('aria-label', 'Ver foto en grande');
		zoom.append(img);
		frame.append(zoom);
		wrap.append(frame);

		let index = 0;
		let startX = 0;
		let suppressClick = false;
		const counter = node('span', 'pointer-events-none absolute bottom-2 left-1/2 z-10 -translate-x-1/2 rounded-full bg-white/90 px-2 py-0.5 text-[10px] tracking-[0.16em] text-ink/50 shadow-sm');
		function show(next) {
			index = (next + photos.length) % photos.length;
			img.style.display = '';
			img.src = photos[index];
			if (photos.length > 1) counter.textContent = index + 1 + ' / ' + photos.length;
		}
		show(0);
		zoom.addEventListener('click', () => {
			if (suppressClick) { suppressClick = false; return; }
			openViewer(photos, alt, index, show);
		});
		if (photos.length < 2) return wrap;

		function arrow(label, symbol) {
			const button = node('button', 'absolute top-1/2 z-10 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full border border-ink/10 bg-white/90 text-ink/70 shadow-sm transition hover:bg-white hover:text-ink');
			button.type = 'button';
			button.setAttribute('aria-label', label);
			button.innerHTML = symbol;
			return button;
		}
		const prev = arrow('Foto anterior', chevron('M8.5 3.5 5 7l3.5 3.5'));
		prev.classList.add('left-2');
		prev.addEventListener('click', () => show(index - 1));
		const next = arrow('Foto siguiente', chevron('M5.5 3.5 9 7l-3.5 3.5'));
		next.classList.add('right-2');
		next.addEventListener('click', () => show(index + 1));
		frame.append(prev, next, counter);

		frame.addEventListener('pointerdown', (event) => {
			const hit = event.target.closest('button');
			if (hit && hit !== zoom) return;
			startX = event.clientX;
		});
		frame.addEventListener('pointerup', (event) => {
			const hit = event.target.closest('button');
			if (hit && hit !== zoom) return;
			const delta = event.clientX - startX;
			if (Math.abs(delta) > 40) {
				suppressClick = true;
				show(delta > 0 ? index - 1 : index + 1);
			}
		});
		return wrap;
	}

	function productPhotos(item) {
		if (!Array.isArray(item.imagenes)) return [];
		return item.imagenes
			.filter((src) => typeof src === 'string' && src !== '')
			.map((src) => {
				if (src.startsWith('/')) return src;
				if (src.startsWith('crm/')) return '/' + src;
				if (src.startsWith('uploads/productos/')) return '/crm/' + src;
				return src;
			})
			.filter((src) => /\/crm\/uploads\/productos\//i.test(src));
	}

	function card(item, phone) {
		const article = node('article', 'shop-card group');
		const photos = productPhotos(item);
		const alt = item.nombre || item.sku || 'Equipo';
		if (photos.length) article.append(gallery(photos, alt));
		else article.append(node('div', 'flex aspect-square items-center justify-center bg-[#f1f4f7] text-[10px] uppercase tracking-[0.16em] text-ink/30', 'Sin foto'));

		const body = node('div', 'shop-card-body');
		body.append(node('p', 'text-[0.6rem] font-bold uppercase tracking-[0.16em] text-orange', item.categoria || 'Equipo'));
		body.append(node('h3', 'mt-1.5 line-clamp-2 min-h-[2.5rem] text-sm font-bold leading-snug text-ink', item.nombre || item.sku));
		if (item.descripcion) {
			body.append(node('p', 'mt-2 line-clamp-2 text-xs leading-5 text-ink/55', item.descripcion));
			const more = node('button', 'mt-2 self-start text-[10px] font-bold uppercase tracking-[0.12em] text-accent transition hover:text-accent-hover', 'Ver ficha');
			more.type = 'button';
			more.addEventListener('click', () => openInfo(item, phone));
			body.append(more);
		}
		body.append(quoteLinks(item, phone));
		article.append(body);
		return article;
	}

	function fold(value) {
		return String(value || '')
			.normalize('NFD')
			.replace(/\p{M}/gu, '')
			.toLowerCase();
	}

	if (root && status && list) {
		const phone = root.dataset.whatsapp || '';
		const filters = document.getElementById('vitrina-filtros');
		const search = document.getElementById('vitrina-buscar');
		const categories = document.getElementById('vitrina-categorias');
		const chips = document.getElementById('vitrina-chips');
		const count = document.getElementById('vitrina-conteo');
		const sortEl = document.getElementById('vitrina-orden');
		let products = [];
		let query = '';
		let category = '';
		let sortBy = 'nombre';

		// Deep link ?categoria=
		const params = new URLSearchParams(window.location.search);
		const initialCat = params.get('categoria');
		if (initialCat) category = fold(initialCat);

		function matches(item) {
			if (category && fold(item.categoria) !== category) return false;
			if (!query) return true;
			const haystack = fold([item.nombre, item.sku, item.descripcion, item.categoria].filter(Boolean).join(' '));
			return query.split(/\s+/).filter(Boolean).every((word) => haystack.includes(word));
		}

		function sorted(items) {
			const copy = items.slice();
			copy.sort((a, b) => {
				const av = fold(a[sortBy] || a.nombre || '');
				const bv = fold(b[sortBy] || b.nombre || '');
				return av.localeCompare(bv, 'es');
			});
			return copy;
		}

		function categoryStats() {
			const map = new Map();
			for (const item of products) {
				const name = String(item.categoria || '').trim() || 'Otros';
				map.set(name, (map.get(name) || 0) + 1);
			}
			return [...map.entries()].sort((a, b) => a[0].localeCompare(b[0], 'es'));
		}

		function paintNav() {
			const stats = categoryStats();
			const total = products.length;
			function paintInto(container, asChips) {
				if (!container) return;
				container.replaceChildren();
				const options = [['', total, 'Todos'], ...stats.map(([name, n]) => [name, n, name])];
				for (const [name, n, label] of options) {
					const on = fold(name) === category || (name === '' && category === '');
					const button = node('button', asChips ? ('shop-chip' + (on ? ' is-on' : '')) : ('shop-cat-btn' + (on ? ' is-on' : '')), '');
					button.type = 'button';
					button.setAttribute('aria-pressed', on ? 'true' : 'false');
					if (asChips) {
						button.textContent = label + (name === '' ? '' : ' · ' + n);
					} else {
						button.append(node('span', '', label));
						button.append(node('span', 'shop-cat-count', String(n)));
					}
					button.addEventListener('click', () => {
						category = fold(name);
						const url = new URL(window.location.href);
						if (name) url.searchParams.set('categoria', name);
						else url.searchParams.delete('categoria');
						history.replaceState({}, '', url.pathname + url.search + '#vitrina');
						paintNav();
						render();
					});
					container.append(button);
				}
			}
			paintInto(categories, false);
			paintInto(chips, true);
		}

		function render() {
			const visible = sorted(products.filter(matches));
			list.replaceChildren();
			if (count) count.textContent = visible.length === 1 ? '1 equipo' : visible.length + ' equipos';
			if (visible.length === 0) {
				status.hidden = false;
				status.textContent = 'Ningún equipo coincide con esa búsqueda.';
				return;
			}
			status.hidden = true;
			status.textContent = '';
			const grid = node('div', 'shop-grid');
			for (const item of visible) grid.append(card(item, phone));
			list.append(grid);
		}

		const endpoint = root.dataset.endpoint || '/crm/api/productos-visibles.php';
		function loadCatalog(attempt) {
			const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
			const timer = controller ? setTimeout(() => controller.abort(), 45000) : 0;
			fetch(endpoint, {
				headers: { Accept: 'application/json' },
				signal: controller ? controller.signal : undefined,
				cache: 'no-store',
			})
				.then(async (response) => {
					const text = await response.text();
					if (!response.ok) throw new Error('http-' + response.status);
					return JSON.parse(text);
				})
				.then((data) => {
					products = Array.isArray(data?.productos) ? data.productos : [];
					if (products.length === 0) {
						status.textContent = 'Todavía no hay equipos publicados. Cuéntanos el recinto y te proponemos el hardware.';
						return;
					}
					// Validate deep-link category
					const names = new Set(products.map((item) => fold(item.categoria)));
					if (category && !names.has(category)) category = '';
					paintNav();
					if (filters) filters.classList.remove('hidden');
					if (search instanceof HTMLInputElement && !search.dataset.bound) {
						search.dataset.bound = '1';
						search.addEventListener('input', () => {
							query = fold(search.value.trim());
							render();
						});
					}
					if (sortEl instanceof HTMLSelectElement && !sortEl.dataset.bound) {
						sortEl.dataset.bound = '1';
						sortEl.addEventListener('change', () => {
							sortBy = sortEl.value || 'nombre';
							render();
						});
					}
					render();
				})
				.catch(() => {
					if (attempt < 2) {
						status.textContent = 'Reintentando cargar el catálogo…';
						setTimeout(() => loadCatalog(attempt + 1), 800);
						return;
					}
					status.textContent = 'No se pudo cargar el catálogo. Recarga la página o escríbenos por WhatsApp.';
				})
				.finally(() => {
					if (timer) clearTimeout(timer);
				});
		}
		loadCatalog(1);
	}
</script>
