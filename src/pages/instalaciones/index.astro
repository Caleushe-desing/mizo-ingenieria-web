---
import Layout from '../../layouts/Layout.astro';
import ConversionCta from '../../components/ConversionCta.astro';
import { SOUND_LANDINGS, landingPath } from '../../lib/landings';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../../lib/seo';

const title = 'Instalación de sonido | Mizo Chile';
const description =
	'Instalación de parlantes, música ambiental y audio para iglesias en Chile. Cotiza el sistema de sonido con Mizo.';

const jsonLd = graphSchema([
	organizationSchema(),
	webPageSchema({ name: title, description, url: absoluteUrl('/instalaciones') }),
]);
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<section class="mizo-band mizo-band-white relative overflow-hidden border-b border-ink/10 pt-24 text-ink sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-6xl px-5 pb-12 sm:px-6 sm:pb-20 lg:px-8">
			<p class="mizo-kicker">Sonido</p>
			<h1 class="mt-3 max-w-3xl text-[2.15rem] font-extrabold leading-[1.1] sm:text-5xl">Instalación de sonido para cada recinto.</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-ink/80">
				Parlantes, música ambiental y audio para iglesias. Elige el servicio y cotiza directo con un asesor de Mizo.
			</p>
			<a href="/contacto" class="mizo-btn mt-8 w-full max-w-md sm:w-fit">Cotizar instalación</a>
		</div>
	</section>

	<section class="mizo-band mizo-band-gray py-12 sm:py-24">
		<div class="mx-auto grid max-w-6xl gap-4 px-5 sm:px-6 lg:px-8">
			{SOUND_LANDINGS.map((landing) => (
				<a href={landingPath(landing.slug)} class="mizo-card block border border-ink/10 bg-surface px-6 py-6 hover:border-accent">
					<span class="block h-1 w-12 bg-orange"></span>
					<p class="mt-4 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">Instalación</p>
					<h2 class="mt-2 text-2xl font-extrabold">{landing.title}</h2>
					<p class="mt-3 text-base leading-7 text-ink/80">{landing.lead}</p>
					<span class="mt-5 inline-block text-base font-bold text-accent-dark">Cotizar {landing.nav}</span>
				</a>
			))}
		</div>
	</section>

	<ConversionCta title="¿Otro recinto?" text="Cuéntanos el espacio. Armamos la propuesta de sonido que corresponde." />
</Layout>
