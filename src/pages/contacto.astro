---
import Layout from '../layouts/Layout.astro';
import { mailUrl, SERVICES, SITE, telUrl, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, localBusinessSchema, organizationSchema, webPageSchema } from '../lib/seo';

const title = 'Contacto | Mizo — Cotiza instalación en Chile';
const description = `Contacta a Mizo: ${SITE.email}, ${SITE.phoneDisplay} o WhatsApp. Cotizaciones de sonido, video, CCTV y soporte TI.`;

const channels = [
	{
		label: 'WhatsApp',
		value: SITE.phoneDisplay,
		detail: 'Canal directo de cotización',
		href: whatsappUrl(),
		external: true,
	},
	{
		label: 'Teléfono',
		value: SITE.phoneDisplay,
		detail: SITE.hours,
		href: telUrl(),
		external: false,
	},
	{
		label: 'Correo',
		value: SITE.email,
		detail: SITE.address,
		href: mailUrl(),
		external: false,
	},
];

const fieldClass =
	'mt-2 w-full border border-white/15 bg-charcoal px-4 py-3.5 text-sm text-white outline-none transition placeholder:text-white/35 focus:border-accent';
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		localBusinessSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/contacto') }),
	])}
>
	<section class="relative min-h-[100svh] overflow-hidden bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="pointer-events-none absolute -right-24 top-24 h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
		<div class="pointer-events-none absolute -left-16 bottom-0 h-72 w-72 bg-orange/10 blur-3xl"></div>

		<div class="relative mx-auto grid max-w-6xl lg:grid-cols-[0.9fr_1.1fr]">
			<div class="border-white/10 px-4 pb-10 sm:px-6 lg:border-r lg:px-8 lg:pb-16">
				<p class="mizo-kicker">Contacto</p>
				<h1 class="mt-4 max-w-md text-4xl font-extrabold leading-[1.1] sm:text-5xl">Solicita una propuesta técnica.</h1>
				<p class="mt-5 max-w-md text-base leading-7 text-white/70">
					Un ingeniero revisa tu requerimiento y te responde con alcance e instalación según tu recinto.
				</p>

				<dl class="mt-10 divide-y divide-white/10 border-y border-white/10">
					{channels.map((channel) => (
						<div>
							<a
								href={channel.href}
								target={channel.external ? '_blank' : undefined}
								rel={channel.external ? 'noopener noreferrer' : undefined}
								class="group grid grid-cols-[7.5rem_1fr] items-center gap-4 py-5 transition hover:bg-white/[0.03]"
							>
								<dt class="text-[0.7rem] font-bold uppercase tracking-[0.18em] text-accent">{channel.label}</dt>
								<dd>
									<p class="text-lg font-bold text-white group-hover:text-orange">{channel.value}</p>
									<p class="mt-1 text-sm text-white/55">{channel.detail}</p>
								</dd>
							</a>
						</div>
					))}
				</dl>

				<div class="mt-8 grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-2">
					<div class="bg-charcoal px-5 py-5">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Cobertura</p>
						<p class="mt-2 text-sm font-semibold leading-6">Frutillar, Santiago y sur de Chile</p>
					</div>
					<div class="bg-charcoal px-5 py-5">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Horario</p>
						<p class="mt-2 text-sm font-semibold leading-6">Lunes a viernes · 9:00 a 18:00</p>
					</div>
				</div>
			</div>

			<div class="bg-charcoal-light/40 px-4 py-10 sm:px-6 lg:px-8 lg:py-0 lg:pb-16">
				<div class="border border-white/10 bg-charcoal-light">
					<div class="flex items-center justify-between border-b border-white/10 px-5 py-4 sm:px-7">
						<div>
							<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">Formulario de cotización</p>
							<p class="mt-1 text-sm text-white/60">Los datos llegan a {SITE.email}</p>
						</div>
						<span class="hidden h-10 w-10 items-center justify-center border border-accent/40 text-xs font-bold text-accent sm:flex">01</span>
					</div>

					<form id="contacto-form" class="p-5 sm:p-7" novalidate>
						<input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
						<div class="grid gap-5 sm:grid-cols-2">
							<label class="block">
								<span class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white/70">Nombre</span>
								<input name="nombre" type="text" required class={fieldClass} />
							</label>
							<label class="block">
								<span class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white/70">Teléfono</span>
								<input name="telefono" type="tel" required class={fieldClass} />
							</label>
							<label class="block sm:col-span-2">
								<span class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white/70">Correo</span>
								<input name="correo" type="email" required class={fieldClass} />
							</label>
							<label class="block sm:col-span-2">
								<span class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white/70">Servicio requerido</span>
								<select name="servicio" required class={`${fieldClass} bg-charcoal`}>
									<option value="">Selecciona una línea</option>
									{SERVICES.map((service) => (
										<option value={service.title}>{service.title}</option>
									))}
								</select>
							</label>
							<label class="block sm:col-span-2">
								<span class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white/70">Mensaje</span>
								<textarea name="mensaje" rows="6" required class={`${fieldClass} resize-y`}></textarea>
							</label>
						</div>
						<div class="mt-7 flex flex-col gap-3 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
							<button type="submit" class="inline-flex items-center justify-center bg-orange px-8 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-white transition hover:bg-orange-hover">
								Enviar solicitud
							</button>
							<p class="text-xs leading-5 text-white/45">Respuesta en horario hábil · Frutillar y Santiago</p>
						</div>
						<p id="contacto-error" class="mt-4 hidden border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm font-semibold text-red-200">
							No se pudo enviar. Escríbenos por WhatsApp o a {SITE.email}.
						</p>
					</form>

					<div id="contacto-ok" class="hidden px-5 py-16 text-center sm:px-7">
						<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-orange">Solicitud recibida</p>
						<h2 class="mt-4 text-3xl font-extrabold">Un ingeniero Mizo te contactará.</h2>
						<p class="mx-auto mt-3 max-w-md text-white/65">Revisaremos tu recinto y el servicio solicitado para armar una propuesta concreta.</p>
						<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex bg-[#25D366] px-6 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white">
							Continuar por WhatsApp
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		(function () {
			const form = document.getElementById('contacto-form');
			const ok = document.getElementById('contacto-ok');
			const error = document.getElementById('contacto-error');
			if (!form) return;

			const params = new URLSearchParams(window.location.search);
			const mensaje = params.get('mensaje');
			const field = form.querySelector('[name="mensaje"]');
			if (mensaje && field instanceof HTMLTextAreaElement && field.value === '') {
				field.value = mensaje;
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				error.classList.add('hidden');
				const payload = Object.fromEntries(new FormData(form).entries());
				try {
					const response = await fetch('/api/contacto.php', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify(payload),
					});
					if (!response.ok) throw new Error('send-failed');
					form.classList.add('hidden');
					ok.classList.remove('hidden');
				} catch {
					error.classList.remove('hidden');
				}
			});
		})();
	</script>
</Layout>
