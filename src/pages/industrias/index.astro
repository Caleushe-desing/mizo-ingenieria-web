---
import ConversionCta from '../../components/ConversionCta.astro';
import Layout from '../../layouts/Layout.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import TechStandards from '../../components/TechStandards.astro';
import { INDUSTRIES, industryPath } from '../../lib/industries';
import { industryMedia } from '../../lib/industry-images';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../../lib/seo';

const title = 'Soluciones | Mizo — Páginas por industria';
const description =
	'Páginas por industria de Mizo: restaurantes, colegios, auditorios, gimnasios y entretenimiento residencial. Enlaces directos para cotizar sonido, video y automatización.';

const jsonLd = graphSchema([
	organizationSchema(),
	webPageSchema({ name: title, description, url: absoluteUrl('/industrias') }),
]);
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8">
			<p class="mizo-kicker">Soluciones</p>
			<h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.1] sm:text-5xl">Ingeniería a medida para cada tipo de recinto.</h1>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">
				Dante, audio multizona, calibración acústica y cine en casa cuando la sala lo pide. Elige el rubro: el diseño, la instalación y el soporte son del mismo equipo.
			</p>
		</div>
	</section>

	<section class="bg-charcoal py-20 sm:py-28">
		<div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 lg:grid-cols-2 lg:gap-8 lg:px-8">
			{INDUSTRIES.map((industry) => (
				<a
					href={industryPath(industry.slug)}
					class="mizo-card group relative flex h-full flex-col overflow-hidden border border-white/10 bg-charcoal hover:-translate-y-1 hover:border-accent/70"
				>
					<PhotoSlot label="" image={industryMedia[industry.slug].hero} class="transition-all duration-300 group-hover:brightness-110" />
					<div class="flex flex-1 flex-col p-6 sm:p-7">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{industry.nav}</p>
						<h2 class="mt-2 text-2xl font-extrabold leading-snug">{industry.title}</h2>
						<p class="mt-3 text-sm leading-7 text-white/80">{industry.short}</p>
						<ul class="mt-5 space-y-2 text-sm text-white/80">
							{industry.solutions.map((solution) => (
								<li class="flex gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 bg-orange"></span>
									<span>{solution.title}</span>
								</li>
							))}
						</ul>
					</div>
					<span class="pointer-events-none absolute inset-0 bg-accent/0 transition-all duration-300 group-hover:bg-accent/10" aria-hidden="true"></span>
				</a>
			))}
		</div>
	</section>

	<TechStandards variant="teaser" />

	<ConversionCta />
</Layout>
