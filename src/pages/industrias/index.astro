---
import ConversionCta from '../../components/ConversionCta.astro';
import Layout from '../../layouts/Layout.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import { INDUSTRIES, industryPath } from '../../lib/industries';
import { SITE } from '../../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../../lib/seo';

const title = 'Soluciones | Mizo — Páginas por industria';
const description =
	'Páginas por industria de Mizo: restaurantes, colegios, auditorios, gimnasios y entretenimiento residencial. Enlaces directos para cotizar sonido, video y automatización.';

const jsonLd = graphSchema([
	organizationSchema(),
	webPageSchema({ name: title, description, url: absoluteUrl('/industrias') }),
]);
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Soluciones</p>
			<h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.1] sm:text-5xl">Una página para cada rubro. Un enlace directo para cada prospecto.</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-white/65">
				Sonido, imagen y control pensados según el recinto. Elige la industria y comparte esa página: el visitante ve solo lo que aplica a su negocio.
			</p>
		</div>
	</section>

	<section class="bg-charcoal py-16 sm:py-20">
		<div class="mx-auto grid max-w-6xl gap-px bg-white/10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
			{INDUSTRIES.map((industry) => (
				<article class="flex flex-col bg-charcoal">
					<PhotoSlot label={industry.imageLabel} />
					<div class="flex flex-1 flex-col p-6 sm:p-7">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{industry.nav}</p>
						<h2 class="mt-2 text-2xl font-extrabold leading-snug">{industry.title}</h2>
						<p class="mt-3 text-sm leading-7 text-white/65">{industry.short}</p>
						<p class="mt-4 font-mono text-xs text-accent">{SITE.url.replace('https://', '')}{industryPath(industry.slug)}</p>
						<ul class="mt-5 space-y-2 text-sm text-white/80">
							{industry.solutions.map((solution) => (
								<li class="flex gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 bg-orange"></span>
									<span>{solution.title}</span>
								</li>
							))}
						</ul>
						<a href={industryPath(industry.slug)} class="mt-auto pt-6 text-sm font-bold uppercase tracking-[0.12em] text-orange">Abrir página</a>
					</div>
				</article>
			))}
		</div>
	</section>

	<ConversionCta />
</Layout>
