---
import { Image } from 'astro:assets';
import ConversionCta from '../components/ConversionCta.astro';
import Layout from '../layouts/Layout.astro';
import manifiesto from '../assets/nosotros/manifiesto.jpg';
import { ENGINEERING_STANDARDS } from '../lib/industries';
import { content } from '../lib/content';
import { SITE } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../lib/seo';

const page = content.pages.nosotros;
const title = page.seoTitle;
const description = page.seoDescription;
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/nosotros') }),
	])}
>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:pb-28">
			<div>
				<p class="mizo-kicker">{page.kicker}</p>
				<h1 class="mt-4 max-w-xl text-4xl font-extrabold leading-[1.05] sm:text-6xl lg:text-5xl">{page.title}</h1>
				<p class="mt-6 max-w-xl text-lg leading-8 text-white/80">
					{page.lead}
				</p>
				<p class="mt-6 text-sm font-semibold tracking-wide text-white/70">{page.coveragePrefix} {SITE.areas.join(', ')}.</p>
			</div>
			<figure class="overflow-hidden border border-white/10">
				<Image
					src={manifiesto}
					alt="Rack de ingeniería y micrófono de medición en un recinto"
					class="aspect-[16/10] h-full w-full object-cover"
					widths={[640, 960, 1280]}
					sizes="(min-width: 1024px) 40vw, 100vw"
					format="webp"
					quality={74}
					loading="eager"
				/>
			</figure>
		</div>
	</section>

	<section class="bg-charcoal py-20 sm:py-28" aria-labelledby="pilares-heading">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<p class="mizo-kicker">{page.pillarsKicker}</p>
			<h2 id="pilares-heading" class="mt-3 max-w-2xl text-3xl font-extrabold sm:text-4xl">{page.pillarsTitle}</h2>
			<ul class="mt-12 grid gap-4 lg:grid-cols-3">
				{page.pillars.map((pillar) => (
					<li class="mizo-card border border-white/10 bg-charcoal px-6 py-10 sm:px-8">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{pillar.n}</p>
						<h3 class="mt-4 text-2xl font-extrabold leading-snug">{pillar.title}</h3>
						<p class="mt-4 text-sm leading-7 text-white/80">{pillar.text}</p>
					</li>
				))}
			</ul>
			<ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
				{ENGINEERING_STANDARDS.map((item) => (
					<li class="mizo-card border border-white/10 bg-charcoal px-5 py-6">
						<p class="text-sm font-extrabold text-white">{item.label}</p>
						<p class="mt-2 text-sm leading-6 text-white/75">{item.detail}</p>
					</li>
				))}
			</ul>
			<a href="/estandares" class="mt-10 inline-block text-sm font-bold uppercase tracking-[0.12em] text-orange transition-all duration-300 hover:text-white">{page.standardsLinkLabel}</a>
		</div>
	</section>

	<ConversionCta title={page.ctaTitle} text={page.ctaText} />
</Layout>
