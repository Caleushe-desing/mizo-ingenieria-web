---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../lib/seo';

const title = 'Nosotros | Mizo — Ingeniería y tecnología en Chile';
const description =
	'Mizo instala sonido, video, cámaras de seguridad y soporte TI con cobertura en Frutillar, Santiago y el sur de Chile.';

const values = [
	{
		n: '01',
		title: 'Ingeniería aplicada',
		text: 'Cada sistema se dimensiona según el recinto, el uso real y la operación del cliente.',
	},
	{
		n: '02',
		title: 'Instalación en terreno',
		text: 'Montaje, cableado, calibración y puesta en marcha con un único equipo responsable.',
	},
	{
		n: '03',
		title: 'Soporte posterior',
		text: 'Acompañamos la operación con mantenimiento, redes y desarrollo cuando el proyecto lo requiere.',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/nosotros') }),
	])}
>
	<section class="relative min-h-[100svh] overflow-hidden bg-charcoal pt-28 sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto grid max-w-6xl lg:grid-cols-2">
			<div class="border-white/10 px-4 pb-12 sm:px-6 lg:border-r lg:px-8 lg:pb-16">
				<p class="mizo-kicker">Nosotros</p>
				<h1 class="mt-4 max-w-md text-4xl font-extrabold leading-[1.1] sm:text-5xl">Equipo técnico, ejecución en terreno y soporte posterior.</h1>
				<p class="mt-5 max-w-md text-lg leading-8 text-white/65">
					Mizo diseña e instala sonido, videoproyección, cámaras de seguridad y soporte TI. Revisamos el recinto, proponemos lo necesario y dejamos el sistema listo para operar.
				</p>
				<div class="mt-10 grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-2">
					<div class="bg-charcoal px-5 py-5">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Cobertura</p>
						<p class="mt-2 text-sm font-semibold leading-6">Frutillar, Santiago y sur de Chile</p>
					</div>
					<div class="bg-charcoal px-5 py-5">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">Contacto</p>
						<p class="mt-2 text-sm font-semibold leading-6">{SITE.phoneDisplay}</p>
					</div>
				</div>
				<a href="/contacto" class="mizo-btn mt-10">Hablar con el equipo</a>
			</div>

			<div class="px-4 py-10 sm:px-6 lg:px-8 lg:py-0">
				<div class="divide-y divide-white/10 border border-white/10">
					{values.map((value) => (
						<article class="grid grid-cols-[3.5rem_1fr] gap-4 px-5 py-7 sm:px-7">
							<p class="text-sm font-bold text-accent">{value.n}</p>
							<div>
								<h2 class="text-xl font-bold">{value.title}</h2>
								<p class="mt-2 text-sm leading-6 text-white/60">{value.text}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>
</Layout>
