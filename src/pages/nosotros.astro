---
import { Image } from 'astro:assets';
import ConversionCta from '../components/ConversionCta.astro';
import Layout from '../layouts/Layout.astro';
import manifiesto from '../assets/nosotros/manifiesto.jpg';
import { ENGINEERING_STANDARDS } from '../lib/industries';
import { SITE } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, webPageSchema } from '../lib/seo';

const title = 'Nosotros | Mizo — Ingeniería y precisión';
const description =
	'Mizo diseña, integra y optimiza sistemas de audio, video y automatización de alto rendimiento para espacios comerciales y residenciales en Chile.';

const pillars = [
	{
		n: '01',
		title: 'Ingeniería quirúrgica y a medida',
		text: 'Estudiamos cada espacio desde cero según su acústica, arquitectura y necesidades operativas reales.',
	},
	{
		n: '02',
		title: 'Estándares profesionales de vanguardia',
		text: 'Trabajamos con tecnología de primer nivel: protocolos Dante, procesamiento DSP, sistemas Dolby Atmos y marcas con respaldo global.',
	},
	{
		n: '03',
		title: 'Acompañamiento directo y postventa real',
		text: 'Soporte técnico local y respuesta rápida, desde la asesoría inicial hasta la puesta en marcha.',
	},
];
---

<Layout
	title={title}
	description={description}
	jsonLd={graphSchema([
		organizationSchema(),
		webPageSchema({ name: title, description, url: absoluteUrl('/nosotros') }),
	])}
>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:pb-20">
			<div>
				<p class="mizo-kicker">Nosotros</p>
				<h1 class="mt-4 max-w-xl text-4xl font-extrabold leading-[1.05] sm:text-6xl lg:text-5xl">Ingeniería y precisión sin compromisos.</h1>
				<p class="mt-6 max-w-xl text-lg leading-8 text-white/70">
					En Mizo no vendemos soluciones genéricas. Diseñamos, integramos y optimizamos sistemas de audio, video y automatización de alto rendimiento para transformar espacios comerciales y residenciales.
				</p>
				<p class="mt-6 text-sm font-semibold tracking-wide text-white/45">Cobertura en {SITE.areas.join(', ')}.</p>
			</div>
			<figure class="overflow-hidden border border-white/10">
				<Image
					src={manifiesto}
					alt="Rack de ingeniería y micrófono de medición en un recinto"
					class="aspect-[16/10] h-full w-full object-cover"
					widths={[640, 960, 1280]}
					sizes="(min-width: 1024px) 40vw, 100vw"
					format="webp"
					quality={74}
					loading="eager"
				/>
			</figure>
		</div>
	</section>

	<section class="bg-charcoal py-16 sm:py-20" aria-labelledby="pilares-heading">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Criterio</p>
			<h2 id="pilares-heading" class="mt-3 max-w-2xl text-3xl font-extrabold sm:text-4xl">Tres pilares. El mismo equipo de principio a fin.</h2>
			<ul class="mt-10 grid gap-px bg-white/10 lg:grid-cols-3">
				{pillars.map((pillar) => (
					<li class="bg-charcoal px-6 py-8 sm:px-8">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">{pillar.n}</p>
						<h3 class="mt-4 text-2xl font-extrabold leading-snug">{pillar.title}</h3>
						<p class="mt-4 text-sm leading-7 text-white/65">{pillar.text}</p>
					</li>
				))}
			</ul>
			<ul class="mt-px grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-5">
				{ENGINEERING_STANDARDS.map((item) => (
					<li class="bg-charcoal px-5 py-5">
						<p class="text-sm font-extrabold text-white">{item.label}</p>
						<p class="mt-2 text-sm leading-6 text-white/55">{item.detail}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<ConversionCta
		title="Conecta con un especialista de Mizo."
		text="Cuéntanos el recinto. Revisamos acústica, arquitectura y operación, y te respondemos con una propuesta a medida."
	/>
</Layout>
