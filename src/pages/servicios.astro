---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import imgSonido from '../assets/servicio-sonido.jpg';
import imgVideo from '../assets/servicio-video.jpg';
import imgCctv from '../assets/servicio-cctv.jpg';
import imgTi from '../assets/servicio-ti.jpg';
import { SERVICES, whatsappUrl } from '../lib/site';
import { absoluteUrl, graphSchema, organizationSchema, serviceSchema, webPageSchema } from '../lib/seo';

const images = {
	sonido: imgSonido,
	video: imgVideo,
	cctv: imgCctv,
	ti: imgTi,
} as const;

const labels = {
	sonido: 'Sonido',
	video: 'Video',
	cctv: 'CCTV',
	ti: 'Soporte TI',
} as const;

const title = 'Servicios | Mizo — Sonido, video, CCTV y soporte TI';
const description =
	'Servicios técnicos de Mizo en Chile: sonido profesional, videoproyección, cámaras de seguridad CCTV y soporte TI e infraestructura.';

const jsonLd = graphSchema([
	organizationSchema(),
	webPageSchema({ name: title, description, url: absoluteUrl('/servicios') }),
	...SERVICES.map((service) =>
		serviceSchema({
			name: service.title,
			description: service.description,
			url: absoluteUrl(service.href),
		}),
	),
]);
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<section class="relative overflow-hidden border-b border-white/10 bg-charcoal pt-28 text-white sm:pt-32">
		<div class="mizo-grid pointer-events-none absolute inset-0 opacity-[0.07]"></div>
		<div class="relative mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
			<p class="mizo-kicker">Servicios</p>
			<h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.1] sm:text-5xl">Cuatro líneas técnicas, un solo estándar de instalación.</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-white/65">
				Diseñamos, instalamos y dejamos operativo cada sistema. Estos son los trabajos que ejecutamos en terreno.
			</p>
			<nav class="mt-8 inline-flex flex-wrap gap-px bg-white/10" aria-label="Líneas de servicio">
				{SERVICES.map((service) => (
					<a href={service.href} class="bg-charcoal px-4 py-2 text-sm font-semibold text-white/80 transition hover:bg-charcoal-light hover:text-white">
						{labels[service.id]}
					</a>
				))}
			</nav>
		</div>
	</section>

	{SERVICES.map((service, index) => (
		<section id={service.id} class:list={['scroll-mt-28 border-b border-white/10 py-16 sm:py-20', index % 2 === 1 ? 'bg-charcoal-light/20' : 'bg-charcoal']}>
			<div class="mx-auto grid max-w-6xl items-start gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-0 lg:px-8">
				<div class:list={['lg:pr-10', index % 2 === 1 ? 'lg:order-2 lg:pr-0 lg:pl-10' : '']}>
					<Image
						src={images[service.id]}
						alt={service.title}
						class="aspect-[16/10] w-full object-cover"
						widths={[480, 800, 1200]}
						sizes="(min-width: 1024px) 50vw, 100vw"
						format="webp"
						quality={72}
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
				</div>
				<div>
					<p class="text-[0.7rem] font-bold uppercase tracking-[0.22em] text-accent">Línea {String(index + 1).padStart(2, '0')}</p>
					<h2 class="mt-3 text-3xl font-extrabold">{service.title}</h2>
					<p class="mt-4 text-base leading-7 text-white/65">{service.description}</p>
					<p class="mt-6 text-[0.7rem] font-bold uppercase tracking-[0.18em] text-orange">Trabajos que realizamos</p>
					<ul class="mt-3 divide-y divide-white/10 border-y border-white/10">
						{service.works.map((work) => (
							<li class="flex gap-3 py-3 text-white/85">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 bg-orange"></span>
								<span>{work}</span>
							</li>
						))}
					</ul>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href="/contacto" class="mizo-btn">Cotizar este servicio</a>
						<a href={whatsappUrl(`Hola Mizo, quiero cotizar ${service.title}.`)} target="_blank" rel="noopener noreferrer" class="mizo-btn-ghost">
							WhatsApp
						</a>
					</div>
				</div>
			</div>
		</section>
	))}

	<section class="bg-charcoal py-14">
		<div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
			<div>
				<h2 class="text-2xl font-extrabold">¿Cuál de estas líneas necesitas?</h2>
				<p class="mt-2 max-w-xl text-white/65">Cuéntanos el recinto y te proponemos la instalación adecuada.</p>
			</div>
			<a href="/contacto" class="mizo-btn">Solicitar cotización</a>
		</div>
	</section>
</Layout>
