ErrorDocument 404 /404.html

RewriteEngine On
RewriteRule ^crm/assets/ - [L]
# Archivos reales del CRM (API, fotos, assets): no pasar por index.php
RewriteCond %{REQUEST_URI} ^/crm/(api|uploads)/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
# Enlaces públicos de cotización: /q/{token} (también /crm/q/...)
RewriteRule ^q(/.*)?$ /crm/index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^crm(/.*)?$ /crm/index.php [QSA,L]

RedirectMatch 301 ^/proyectos/?$ /servicios
RedirectMatch 301 ^/about/?$ /nosotros
RedirectMatch 301 ^/testimonios/?$ /nosotros
RedirectMatch 301 ^/equipamiento/?$ /servicios
RedirectMatch 301 ^/estandares(/.*)?$ /industrias
RedirectMatch 301 ^/productos(/.*)?$ /equipos
RedirectMatch 301 ^/carrito/?$ /
RedirectMatch 301 ^/configurador/?$ /
RedirectMatch 301 ^/blog(/.*)?$ /
RedirectMatch 301 ^/admin(/.*)?$ /
RedirectMatch 301 ^/encuesta-satisfaccion/?$ /
RedirectMatch 301 ^/gracias(-encuesta)?/?$ /
